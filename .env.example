PORT=3000
BASE_URL=https://firmledger.co.ke
ADMIN_SECRET=change-this-to-a-long-random-string

# Where the admin sign-in OTP email goes (step 2 of the admin chain:
# secret -> emailed 6-digit code -> authenticator). Default: admin@firmledger.co.ke.
# Can also be changed in Admin -> Settings -> Two-factor (stored on the account).
#ADMIN_2FA_EMAIL=admin@firmledger.co.ke

# Mail — same From on every hop. Primary then failover slots (tried in order
# when a hop hits a sending limit). Admin → Settings can add more providers
# (Brevo, Maileroo, Resend, SMTP2GO, Mailjet, Mailtrap, AhaSend, SMTPfast,
# Forward Email, DNSExit, Emitlo, Zoho, custom).
MAIL_FROM=FirmLedger <no-reply@firmledger.co.ke>
SMTP_URL=
SMTP2_URL=
SMTP3_URL=

# Payments (FirmLedger Pro) — PayPal REST Orders.
# Leave blank and paste credentials in Admin → Settings → Payments instead (env wins when set).
# Create an app at https://developer.paypal.com → Apps & Credentials.
# Use Sandbox credentials while PAYPAL_MODE=sandbox (charges nothing);
# switch to your live app's credentials with PAYPAL_MODE=live to accept real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Public status page (https://firmledger.co.ke/status)
# STATUS_EMAIL_FROM is used as the From for status-subscription emails (falls back to MAIL_FROM).
# STATUS_UPDATE_INTERVAL is how often the monitor probes components, in seconds (min 15, default 60).
# The status page and /status/api are free and public — nothing to set up,
# and the API health probe is preconfigured too: the monitor provisions its own
# regular API key automatically (an internal lifetime-Pro account created
# through the normal API-keys flow) to authenticate /api/v1/health like any
# other API client. STATUS_API_KEY is an OPTIONAL override if you'd rather the
# probe use a specific Pro key from your dashboard (Dashboard → API → Keys).
STATUS_EMAIL_FROM=status@firmledger.co.ke
STATUS_UPDATE_INTERVAL=60
STATUS_API_KEY=

# API webhooks — use a long random value and keep it stable across deploys so
# existing webhook signing secrets remain decryptable after a restart.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_TIMEOUT_MS=10000

# Google Indexing API (optional)
# Paste the whole service-account JSON on ONE line (the file contents, stringified).
# Google Cloud → IAM & Admin → Service accounts → Keys → Add key → JSON.
#
#   # Where "look for news about this company" searches. Defaults to Google News RSS;
# the literal ${q} is replaced with the URL-encoded query. Any RSS/Atom search
# endpoint works — e.g. a Bing News feed or your own newsroom aggregator.
NEWS_SEARCH_URL=

GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
#
# This is the production path — nothing sensitive touches the repo. When it is
# unset the app falls back to data/service-account.json (what Admin → Settings →
# Google Indexing API saves), then to a local ./service-account.json in
# development. All three are git-ignored. Remember to grant the service account
# Owner (or at least "URL owner") on the property in Google Search Console.
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=

# Search indexing (optional)
# The app keeps any host that is not its own public origin out of search engines:
# if BASE_URL is unset or points at localhost / a .test / .local name / a private IP,
# every response carries "X-Robots-Tag: noindex, follow" and /robots.txt becomes
# "Disallow: /". Production with a real BASE_URL needs nothing here.
# Set FORCE_INDEXABLE=1 only when you DO want a non-standard host indexed.
#FORCE_INDEXABLE=1

# ---------------------------------------------------------------------------
# AI model providers (Admin → AI Playground → Settings → Model providers)
#
# The console runs on ONE provider at a time — you pick it in the admin UI, and
# you can paste keys for as many as you like; the rest stay dormant. An
# environment variable always wins over a key saved in the console, which is the
# production-safe way to inject secrets. Keys are never rendered back to the
# browser, only a masked hint.
#
#   GROQ_API_KEY       Groq            https://console.groq.com/keys
#   OPENAI_API_KEY     OpenAI          https://platform.openai.com/api-keys
#   ANTHROPIC_API_KEY  Claude          https://console.anthropic.com/settings/keys
#   GEMINI_API_KEY     Google Gemini   https://aistudio.google.com/app/apikey
#   DEEPSEEK_API_KEY   DeepSeek        https://platform.deepseek.com/api_keys
#   HUGGINGFACE_API_KEY Hugging Face   https://huggingface.co/settings/tokens
#   OPENROUTER_API_KEY OpenRouter      https://openrouter.ai/settings/keys
#   MISTRAL_API_KEY    Mistral         https://console.mistral.ai/api-keys
#   TOGETHER_API_KEY   Together AI     https://api.together.xyz/settings/api-keys
#   XAI_API_KEY        xAI (Grok)      https://console.x.ai
#   CEREBRAS_API_KEY   Cerebras        https://cloud.cerebras.ai
#   SAMBANOVA_API_KEY  SambaNova       https://cloud.sambanova.ai/apis
#   FIREWORKS_API_KEY  Fireworks AI    https://fireworks.ai/account/api-keys
#   PERPLEXITY_API_KEY Perplexity      https://www.perplexity.ai/settings/api
#   COHERE_API_KEY     Cohere          https://dashboard.cohere.com/api-keys
#   GITHUB_TOKEN       GitHub Models   https://github.com/settings/tokens
#
# Ollama needs no key — set OLLAMA_BASE_URL if it is not on the default port.
# The "Custom gateway" slot takes any OpenAI-compatible endpoint (LiteLLM, vLLM,
# Azure, a company proxy): give it a base URL plus its key.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
COHERE_API_KEY=
#GITHUB_TOKEN=

# Optional endpoint overrides — only needed for a proxy or a non-default port.
#GROQ_BASE_URL=https://api.groq.com/openai/v1
#OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#CUSTOM_LLM_BASE_URL=https://llm.internal.example/v1
#CUSTOM_LLM_API_KEY=

# Social sign-in (Passport.js) — leave blank to hide the buttons on /login.
# Google:   https://console.cloud.google.com → APIs & Services → Credentials →
#           OAuth client ID (Web application). Authorized redirect URI:
#           <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn: https://www.linkedin.com/developers/apps → Auth. Product:
#           "Sign In with LinkedIn using OpenID Connect". Redirect URL:
#           <BASE_URL>/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
