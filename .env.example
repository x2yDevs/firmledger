PORT=3000
BASE_URL=https://firmledger.co.ke
ADMIN_SECRET=change-this-to-a-long-random-string

# Mail — same From on every hop. Primary then failover slots (tried in order
# when a hop hits a sending limit). Admin → Settings can add more providers
# (Brevo, Maileroo, Resend, SMTP2GO, Mailjet, Mailtrap, AhaSend, SMTPfast,
# Forward Email, DNSExit, Emitlo, Zoho, custom).
MAIL_FROM=FirmLedger <no-reply@firmledger.co.ke>
SMTP_URL=
SMTP2_URL=
SMTP3_URL=

# Payments (FirmLedger Pro) — PayPal REST Orders.
# Leave blank and paste credentials in Admin → Settings → Payments instead (env wins when set).
# Create an app at https://developer.paypal.com → Apps & Credentials.
# Use Sandbox credentials while PAYPAL_MODE=sandbox (charges nothing);
# switch to your live app's credentials with PAYPAL_MODE=live to accept real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Public status page (https://firmledger.co.ke/status)
# STATUS_EMAIL_FROM is used as the From for status-subscription emails (falls back to MAIL_FROM).
# STATUS_UPDATE_INTERVAL is how often the monitor probes components, in seconds (min 15, default 60).
# STATUS_API_KEY: every /api/v1 endpoint (including /health) requires a Pro key, so the
# status monitor authenticates with it. Leave it blank and the API probe gets 401, which
# now shows as a degraded API component and an auto-opened incident on /status.
#
# Where to get the value (it is a normal Pro API key, nothing special):
#   1. Sign in to FirmLedger as a user account you control — a dedicated one such as
#      status@yourdomain is cleaner than a person's account.
#   2. Give that account Pro: Admin console → Users → find the user → Plan → "Grant Pro"
#      (or "Lifetime Pro", which is the sensible choice for a monitoring account so the
#      probe never breaks when a 30-day grant lapses).
#   3. As that user, open /dashboard/api → "Create key". Label it "status monitor".
#      /api/v1/health needs no scope at all, but a key must carry at least one, so
#      untick everything except read:usage — least privilege for a probe.
#   4. Copy the fl_live_… value shown once on screen and paste it below, then restart.
# Rotating: create the new key first, swap it in here, restart, then revoke the old one.
STATUS_EMAIL_FROM=status@firmledger.co.ke
STATUS_UPDATE_INTERVAL=60
STATUS_API_KEY=

# API webhooks — use a long random value and keep it stable across deploys so
# existing webhook signing secrets remain decryptable after a restart.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_TIMEOUT_MS=10000

# Google Indexing API (optional)
# Paste the whole service-account JSON on ONE line (the file contents, stringified).
# Google Cloud → IAM & Admin → Service accounts → Keys → Add key → JSON.
#
#   GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
#
# This is the production path — nothing sensitive touches the repo. When it is
# unset the app falls back to data/service-account.json (what Admin → Settings →
# Google Indexing API saves), then to a local ./service-account.json in
# development. All three are git-ignored. Remember to grant the service account
# Owner (or at least "URL owner") on the property in Google Search Console.
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=

# Search indexing (optional)
# The app keeps any host that is not its own public origin out of search engines:
# if BASE_URL is unset or points at localhost / a .test / .local name / a private IP,
# every response carries "X-Robots-Tag: noindex, follow" and /robots.txt becomes
# "Disallow: /". Production with a real BASE_URL needs nothing here.
# Set FORCE_INDEXABLE=1 only when you DO want a non-standard host indexed.
#FORCE_INDEXABLE=1

# Groq (Admin → AI Playground). Env always wins over a key pasted in the console.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Social sign-in (Passport.js) — leave blank to hide the buttons on /login.
# Google:   https://console.cloud.google.com → APIs & Services → Credentials →
#           OAuth client ID (Web application). Authorized redirect URI:
#           <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn: https://www.linkedin.com/developers/apps → Auth. Product:
#           "Sign In with LinkedIn using OpenID Connect". Redirect URL:
#           <BASE_URL>/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
