<%- include('../partials/top') %>

<section class="page-head blog-head">
  <div class="container">
    <p class="klabel">News &amp; insights</p>
    <h1>The FirmLedger blog</h1>
    <p class="muted blog-lede">Methodology notes, product decisions and release notes — written by the team, never auto-generated.</p>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <% if (!posts.length) { %>
    <div class="empty-state rv"><h3>Nothing published yet</h3><p>Check back soon for methodology notes and product updates.</p></div>
    <% } else { %>
    <div class="blog-grid">
      <% posts.forEach(function(p, i){ %>
      <article class="blog-card rv" style="--d:<%= i*60 %>ms">
        <a class="blog-card-link" href="/blog/<%= p.slug %>">
          <span class="blog-date"><%= fmtDate(p.published_at) %></span>
          <h3><%= p.title %></h3>
          <p><%= p.excerpt %></p>
          <span class="blog-more">Read &rsaquo;</span>
        </a>
      </article>
      <% }); %>
    </div>
    <% } %>
  </div>
</section>

<%- include('../partials/bottom') %>
