<%- include('partials/top') %>

<section class="maint-hero">
  <div class="maint-stage" aria-hidden="true">
    <div class="maint-grid"></div>
    <div class="maint-glow maint-glow-a"></div>
    <div class="maint-glow maint-glow-b"></div>
    <div class="maint-scan"></div>
  </div>

  <div class="container maint-wrap">

    <div class="maint-card">
      <div class="maint-mark">
        <span class="maint-ring"></span>
        <span class="maint-ring maint-ring-b"></span>
        <img src="/assets/logo-mark.png" alt="" width="46" height="46" class="maint-logo">
      </div>

      <p class="maint-kicker">
        <span class="maint-kdot" aria-hidden="true"></span>
        Scheduled maintenance
        <span class="maint-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </p>

      <h1 class="maint-title"><%= m.title %></h1>
      <p class="maint-msg"><%= m.message %></p>

      <% if (m.eta) { %>
      <p class="maint-eta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Expected back: <b><%= m.eta %></b>
      </p>
      <% } %>

      <div class="maint-progress" role="status" aria-label="Update in progress">
        <div class="maint-bar"><i></i></div>
        <span class="maint-progress-note">Applying the update</span>
      </div>

      <p class="maint-fine">Your listings, account and payments are untouched.</p>

      <div class="maint-actions">
        <a class="btn btn-primary" href="/status">Check live status</a>
        <span class="maint-autorefresh" id="maintAuto">Auto-refreshing</span>
      </div>
    </div>

    <div class="maint-assure">
      <div class="maint-assure-card">
        <span class="maint-assure-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
        <h2>Your data is safe</h2>
        <p>Listings, accounts and payments are untouched by this update.</p>
      </div>
      <div class="maint-assure-card">
        <span class="maint-assure-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></span>
        <h2>Status stays live</h2>
        <p>Follow the work in real time on the <a href="/status">system status page</a>.</p>
      </div>
      <div class="maint-assure-card">
        <span class="maint-assure-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg></span>
        <h2>We&rsquo;ll bring you back</h2>
        <p>This page checks every 20 seconds and reloads when we&rsquo;re back.</p>
      </div>
    </div>

  </div>
</section>

<script>
/* Quietly poll the page the visitor asked for: the moment maintenance lifts
   (any non-503 answer) the tab reloads itself back to the real site. Pauses
   while the tab is hidden so it never burns cycles in the background. */
(function () {
  var el = document.getElementById('maintAuto');
  var tick = 20000, timer = null;
  function poll() {
    fetch(location.href, { cache: 'no-store', redirect: 'follow' })
      .then(function (r) { if (r.status !== 503) location.reload(); })
      .catch(function () { /* offline — try again on the next tick */ });
  }
  function start() { if (!timer) timer = setInterval(poll, tick); }
  function stop() { clearInterval(timer); timer = null; }
  document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
  start();
  if (el) el.textContent = 'Auto-refreshing every 20s';
})();
</script>

<%- include('partials/bottom') %>
