<%- include('../partials/top') %>

<section class="auth-wrap">
  <div class="auth-card rv">
    <div class="auth-head">
      <img src="/assets/logo-mark.png" alt="FirmLedger logo" width="40" height="40">
      <h1>Create your account</h1>
      <p class="muted">Submit listings, claim your business, manage your record.</p>
    </div>
    <% if (errors.length) { %><div class="alert alert-err"><% errors.forEach(function (e) { %><div><%= e %></div><% }) %></div><% } %>
    <% const nextQs = (typeof next !== 'undefined' && next) ? '?next=' + encodeURIComponent(next) : ''; %>
    <% if ((typeof oauthGoogle !== 'undefined' && oauthGoogle) || (typeof oauthLinkedIn !== 'undefined' && oauthLinkedIn)) { %>
    <div class="oauth-buttons">
      <% if (typeof oauthGoogle !== 'undefined' && oauthGoogle) { %>
      <a class="btn btn-oauth" href="/auth/google<%= nextQs %>" rel="nofollow">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
          <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
          <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.96H.96a9 9 0 0 0 0 8.08l3.01-2.32z"/>
          <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.96l3.01 2.32C4.68 5.16 6.66 3.58 9 3.58z"/>
        </svg>
        <span>Continue with Google</span>
      </a>
      <% } %>
      <% if (typeof oauthLinkedIn !== 'undefined' && oauthLinkedIn) { %>
      <a class="btn btn-oauth" href="/auth/linkedin<%= nextQs %>" rel="nofollow">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="#0A66C2" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
        </svg>
        <span>Continue with LinkedIn</span>
      </a>
      <% } %>
    </div>
    <div class="oauth-divider"><span>or register with email</span></div>
    <% } %>
    <form method="post" action="/register" class="form">
      <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
      <% if (typeof next !== 'undefined' && next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
      <label><span>Full name</span>
        <input type="text" name="name" required autocomplete="name" value="<%= old.name || '' %>">
      </label>
      <label><span>Email address</span>
        <input type="email" name="email" required autocomplete="email" value="<%= old.email || '' %>">
      </label>
      <label><span>Password <small class="muted">(min 8 characters)</small></span>
        <div class="pw-wrap"><input type="password" id="reg-password" name="password" required minlength="8" autocomplete="new-password" data-pw-input="reg-pw-meter"></div>
        <div class="pw-meter" id="reg-pw-meter" style="display:none"></div>
      </label>
      <label><span>Confirm password</span>
        <div class="pw-wrap"><input type="password" id="reg-password2" name="password_confirm" required minlength="8" autocomplete="new-password" data-pw-confirm="reg-password" data-pw-note="reg-pw-match"></div>
        <div class="pw-match" id="reg-pw-match"></div>
      </label>
      <label class="checker" style="display:flex;gap:10px;align-items:flex-start;margin:4px 0 14px">
        <input type="checkbox" name="newsletter" value="1" checked style="margin-top:4px">
        <span style="font-size:.88rem;line-height:1.5;color:var(--ink2)">Email me the weekly digest — new verified companies and freshly added listings. One-click unsubscribe anytime.</span>
      </label>
      <button class="btn btn-primary btn-block" type="submit">Create account</button>
      <p class="fine-print">By creating an account you agree to keep your listings accurate and up to date.</p>
    </form>
    <p class="auth-alt">Already have an account? <a href="/login<%= nextQs %>">Sign in</a></p>
  </div>
</section>

<%- include('../partials/bottom') %>
