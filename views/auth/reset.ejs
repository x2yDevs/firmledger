<%- include('../partials/top') %>

<section class="auth-wrap">
  <div class="auth-card">
    <div class="auth-head">
      <img src="/assets/logo-mark.png" alt="" width="40" height="40">
      <h1>Choose a new password</h1>
    </div>
    <% if (errors.length) { %><div class="alert alert-err"><% errors.forEach(function (e) { %><div><%= e %></div><% }) %></div><% } %>
    <form method="post" action="/reset/<%= token %>" class="form">
      <label><span>New password <small class="muted">(min 8 characters)</small></span>
        <div class="pw-wrap"><input type="password" id="reset-password" name="password" required minlength="8" autocomplete="new-password" data-pw-input="reset-pw-meter"></div>
        <div class="pw-meter" id="reset-pw-meter" style="display:none"></div>
      </label>
      <label><span>Confirm new password</span>
        <div class="pw-wrap"><input type="password" id="reset-password2" name="password_confirm" required minlength="8" autocomplete="new-password" data-pw-confirm="reset-password" data-pw-note="reset-pw-match"></div>
        <div class="pw-match" id="reset-pw-match"></div>
      </label>
      <button class="btn btn-primary btn-block" type="submit">Update password</button>
    </form>
  </div>
</section>

<%- include('../partials/bottom') %>
