<%- include('../partials/top') %>

<section class="auth-wrap">
  <div class="auth-card">
    <div class="auth-head">
      <img src="/assets/logo-mark.png" alt="FirmLedger logo" width="40" height="40">
      <h1>Admin console</h1>
      <p class="muted">Enter the admin secret code to continue.</p>
    </div>
    <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>
    <form method="post" action="/admin3119Musa" class="form">
      <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
      <label><span>Admin secret code</span>
        <input type="password" name="code" required autocomplete="off" autofocus>
      </label>
      <button class="btn btn-primary btn-block" type="submit">Unlock console</button>
    </form>
    <p class="fine-print">Sign-in is a three-step chain: the admin secret code (<code>ADMIN_SECRET</code>), a one-time 6-digit code emailed to the admin inbox, then your authenticator app (Google Authenticator, 1Password, Authy… — scanned once, kept on the account).</p>
  </div>
</section>

<%- include('../partials/bottom') %>
