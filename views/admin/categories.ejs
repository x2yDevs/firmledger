<%- include('../partials/top') %>
<%- include('../partials/adminnav') %>

<section class="section-tight">
  <div class="container admin-form-cap">
    <div class="section-head"><h2>Categories</h2></div>
    <p class="muted" style="max-width:680px">Official categories ship with FirmLedger. Members can create new ones from the listing form — the system merges duplicates automatically (“Fintech”, “fintech ”, “FinTech” are one category). Renaming here updates every listing that uses it.</p>

    <form method="post" action="/admin3119Musa/categories" class="form form-card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="claim-form-row">
        <label style="flex:1;margin:0;min-width:0"><span class="sr-only">New category</span>
          <input type="text" name="name" required maxlength="40" placeholder="Create category, e.g. InsurTech">
        </label>
        <button class="btn btn-primary" type="submit">+ Create</button>
      </div>
    </form>

    <div class="scroll-table">
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Category</th><th>Slug</th><th>Origin</th><th>Listings</th><th style="min-width:220px">Rename</th><th class="ta-right">Delete</th></tr></thead>
          <tbody>
            <% cats.forEach(function (c) { %>
              <tr>
                <td><strong><%= c.name %></strong></td>
                <td><code><%= c.slug %></code></td>
                <td><% if (c.official) { %><span class="pill pill-approved">official</span><% } else { %><span class="pill pill-pending">member-created</span><% } %></td>
                <td><%= c.in_use %></td>
                <td>
                  <form method="post" action="/admin3119Musa/categories/<%= c.id %>/rename" class="inline rename-row">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="text" name="name" value="<%= c.name %>" maxlength="40" class="rename-input">
                    <button class="btn btn-ghost btn-xs" type="submit">Save</button>
                  </form>
                </td>
                <td class="ta-right">
                  <form method="post" action="/admin3119Musa/categories/<%= c.id %>/delete" class="inline" onsubmit="return confirm('Delete “<%= c.name %>”? <%= c.in_use %> listing(s) will move to Other.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-danger btn-xs" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
