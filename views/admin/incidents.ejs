<%- include('../partials/top') %>
<%- include('../partials/adminnav') %>

<section class="section-tight">
  <div class="container">
    <div class="section-head">
      <h2>Incidents — public status</h2>
      <p class="muted" style="font-size:14px">Open a new incident and it appears on the public <a href="/status">/status</a> page instantly. You can update its timeline, change its status and resolve it from here.</p>
    </div>

    <% if (typeof ok !== 'undefined' && ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
    <% if (typeof err !== 'undefined' && err) { %><div class="alert alert-err"><%= err %></div><% } %>
    <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
      <div class="alert alert-err"><% errors.forEach(function (e) { %><div><%= e %></div><% }); %></div>
    <% } %>

    <div class="side-card" style="margin-bottom:18px">
      <div class="section-head" style="display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:14px">
        <div>
          <h3 style="margin-bottom:4px">Live status — auto-detected</h3>
          <p class="muted" style="font-size:14px;margin:0">The public status monitor probes every component automatically. This is the state it has detected right now, <b>even before a human opens an incident</b>. Clear a detected state once it resolves, or open an incident above to keep it public.</p>
        </div>
        <form method="post" action="/admin3119Musa/status/refresh" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-primary" type="submit">Refresh status now</button>
        </form>
      </div>

      <div class="st-hero" style="margin:0 0 16px;padding:18px 20px">
        <span class="st-dot st-dot-<%= snapshot.status %>" style="width:16px;height:16px;flex:0 0 16px;margin-top:3px" aria-hidden="true"></span>
        <div>
          <div style="font:700 20px/1.2 var(--fd);color:var(--ink)"><%= snapshot.status_label %></div>
          <div class="muted" style="font-size:12.5px;margin-top:2px">
            Last checked <%= (snapshot.last_checked || snapshot.timestamp || '').slice(0, 16).replace('T', ' ') %> UTC
            <% if (snapshot.active_incidents && snapshot.active_incidents.length) { %> · <b><%= snapshot.active_incidents.length %> active incident<%= snapshot.active_incidents.length === 1 ? '' : 's' %></b><% } %>
          </div>
        </div>
      </div>

      <div style="margin-bottom:16px">
        <span class="st-up-label" style="font:600 12px/1 var(--fm);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)">Platform uptime</span>
        <div class="st-uptime" style="margin:10px 0 0;padding:0;border:0;background:none;box-shadow:none;grid-template-columns:repeat(4,1fr)">
          <div class="st-up-cell"><span class="st-up-n"><%= snapshot.uptime['24h'] %>%</span><span class="st-up-l">24h</span></div>
          <div class="st-up-cell"><span class="st-up-n"><%= snapshot.uptime['7d'] %>%</span><span class="st-up-l">7d</span></div>
          <div class="st-up-cell"><span class="st-up-n"><%= snapshot.uptime['30d'] %>%</span><span class="st-up-l">30d</span></div>
          <div class="st-up-cell"><span class="st-up-n"><%= snapshot.uptime['90d'] %>%</span><span class="st-up-l">90d</span></div>
        </div>
      </div>

      <div class="scroll-panel">
        <table class="table">
          <thead><tr><th style="width:40%">Component</th><th>Detected status</th><th>24h</th><th>7d</th><th>30d</th><th style="width:120px">Action</th></tr></thead>
          <tbody>
            <% live.forEach(function (c) { %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:10px">
                  <span class="st-dot st-dot-<%= c.status %>" aria-hidden="true"></span>
                  <div>
                    <div style="font:600 13.5px/1.3 var(--fb);color:var(--ink)"><%= c.name %></div>
                    <div class="muted" style="font-size:11.5px"><%= c.description %></div>
                  </div>
                </div>
              </td>
              <td><span class="st-pill st-pill-<%= c.status %>"><%= c.status_label %></span></td>
              <td><span class="st-cmp-up"><i class="st-bar st-bar-<%= c.uptime['24h'] >= 99 ? 'ok' : 'warn' %>" style="width:<%= c.uptime['24h'] %>%"></i><%= c.uptime['24h'] %>%</span></td>
              <td><span class="st-cmp-up"><i class="st-bar st-bar-<%= c.uptime['7d'] >= 99 ? 'ok' : 'warn' %>" style="width:<%= c.uptime['7d'] %>%"></i><%= c.uptime['7d'] %>%</span></td>
              <td><span class="st-cmp-up"><i class="st-bar st-bar-<%= c.uptime['30d'] >= 99 ? 'ok' : 'warn' %>" style="width:<%= c.uptime['30d'] %>%"></i><%= c.uptime['30d'] %>%</span></td>
              <td>
                <% if (c.status !== 'operational') { %>
                <form method="post" action="/admin3119Musa/status/components/<%= c.id %>/reset" class="inline" onsubmit="return confirm('Clear the detected “<%= c.status_label %>” state for <%= c.name.replace(/"/g, '') %>? It will be re-checked automatically.');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-xs" type="submit">Clear</button>
                </form>
                <% } else { %>
                <span class="muted" style="font-size:12px">—</span>
                <% } %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (detected && detected.length) { %>
    <div class="side-card" style="margin-bottom:18px">
      <h3 style="margin-bottom:4px">Recently detected changes</h3>
      <p class="muted" style="font-size:14px;margin:0 0 12px">Auto-detected degradations / outages from the monitor in the last 48 hours. These are logged automatically before any incident is opened.</p>
      <div class="scroll-panel">
        <table class="table">
          <thead><tr><th>Component</th><th>Detected</th><th>When (UTC)</th><th style="width:110px">Action</th></tr></thead>
          <tbody>
            <% detected.forEach(function (d) { %>
            <tr>
              <td><%= d.component_name || 'Unknown' %></td>
              <td><span class="st-pill st-pill-<%= d.status %>"><%= d.status %></span></td>
              <td><%= (d.checked_at || '').slice(0, 16).replace('T', ' ') %></td>
              <td>
                <% const dComp = live.filter(function (x) { return Number(x.id) === Number(d.component_id); })[0]; %>
                <% if (dComp && dComp.status !== 'operational') { %>
                <form method="post" action="/admin3119Musa/status/components/<%= dComp.id %>/reset" class="inline" onsubmit="return confirm('Clear the detected “<%= d.status %>” state for <%= (d.component_name || '').replace(/"/g, '') %>?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-xs" type="submit">Clear</button>
                </form>
                <% } else { %><span class="muted" style="font-size:12px">resolved</span><% } %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <div class="side-card" style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap">
      <div>
        <h3 style="margin-bottom:4px">Weekly status report</h3>
        <p class="muted" style="font-size:14px;margin:0">Email a weekly uptime + incident summary to every status subscriber.</p>
      </div>
      <form method="post" action="/admin3119Musa/incidents/config/weekly" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="weekly_on" value="<%= weeklyReportOn ? '0' : '1' %>">
        <button class="btn btn-ghost" type="submit"><%= weeklyReportOn ? 'Disable' : 'Enable' %></button>
      </form>
    </div>

    <div class="form-card">
      <h3 class="form-section">Open a new incident</h3>
      <form class="form" method="post" action="/admin3119Musa/incidents">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid-2">
          <label style="grid-column:1 / -1"><span>Title *</span><input type="text" name="title" placeholder="e.g. Elevated API error rate" required maxlength="200" value="<%= typeof old !== 'undefined' && old.title ? old.title : '' %>"></label>
        </div>
        <div class="grid-3">
          <label><span>Affected component</span>
            <select name="component_id">
              <option value="">All systems</option>
              <% components.forEach(function (c) { %>
              <option value="<%= c.id %>" <%= typeof old !== 'undefined' && Number(old.component_id) === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </label>
          <label><span>Severity</span>
            <select name="severity">
              <% Object.keys(severityLabels).forEach(function (s) { %>
              <option value="<%= s %>" <%= typeof old !== 'undefined' && old.severity === s ? 'selected' : '' %>><%= severityLabels[s] %></option>
              <% }); %>
            </select>
          </label>
          <label><span>Initial status</span>
            <select name="status">
              <% Object.keys(incidentStatusLabels).forEach(function (s) { %>
              <option value="<%= s %>" <%= typeof old !== 'undefined' && old.status === s ? 'selected' : '' %>><%= incidentStatusLabels[s] %></option>
              <% }); %>
            </select>
          </label>
        </div>
        <label><span>Description (shown on the public page)</span>
          <textarea name="description" rows="3" placeholder="What's going on? — optional, but incidents with context are far more useful to subscribers."><%= typeof old !== 'undefined' && old.description ? old.description : '' %></textarea>
        </label>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit">Open incident</button>
        </div>
      </form>
    </div>

    <div class="side-card">
      <h3>Recent incidents</h3>
      <% if (incidents.length) { %>
      <div class="scroll-panel">
      <div class="incident-list">
        <% incidents.forEach(function (inc) { %>
        <article class="incident-card">
          <div class="section-head" style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:10px">
            <div>
              <div class="incident-title"><%= inc.title %></div>
              <div class="incident-meta">
                <span class="pill pill-<%= inc.status === 'resolved' ? 'approved' : (inc.status === 'monitoring' ? 'pending' : 'rejected') %>"><%= inc.status %></span>
                <span class="pill pill-<%= inc.severity === 'critical' ? 'rejected' : inc.severity === 'major' ? 'pending' : 'approved' %>"><%= inc.severity %></span>
                <% if (inc.component_name) { %><span class="muted" style="font-size:12px"><%= inc.component_name %></span><% } %>
                <span class="muted" style="font-size:12px">opened <%= (inc.created_at || '').slice(0, 16).replace('T', ' ') %></span>
              </div>
            </div>
            <div class="incident-actions">
            <% if (inc.status !== 'resolved') { %>
            <form method="post" action="/admin3119Musa/incidents/<%= inc.id %>/resolve" class="inline" onsubmit="return confirm('Resolve “<%= inc.title.replace(/\"/g, '') %>”?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-primary btn-xs" type="submit">Resolve</button>
            </form>
            <% } %>
            <form method="post" action="/admin3119Musa/incidents/<%= inc.id %>/delete" class="inline" onsubmit="return confirm('Delete “<%= inc.title.replace(/\"/g, '') %>” permanently? The incident and its whole timeline are removed from the public status page and from history. This cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-danger btn-xs" type="submit">Delete</button>
            </form>
            </div>
          </div>
          <% if (inc.description) { %><p class="muted" style="font-size:14px;margin-bottom:12px"><%= inc.description %></p><% } %>

          <div class="incident-updates">
            <% inc.updates.forEach(function (u) { %>
            <div class="incident-update">
              <span class="incident-update-dot" aria-hidden="true"></span>
              <div>
                <div class="incident-update-status"><%= u.status %> <span class="muted" style="font-size:11px;font-weight:400">· <%= (u.created_at || '').slice(0, 16).replace('T', ' ') %></span></div>
                <div class="incident-update-msg"><%= u.message %></div>
              </div>
            </div>
            <% }); %>
          </div>

          <form method="post" action="/admin3119Musa/incidents/<%= inc.id %>/update" class="form incident-update-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="grid-2" style="align-items:end">
              <label><span>New status</span>
                <select name="status" aria-label="Update status">
                  <% Object.keys(incidentStatusLabels).forEach(function (s) { %>
                  <option value="<%= s %>" <%= inc.status === s ? 'selected' : '' %>><%= incidentStatusLabels[s] %></option>
                  <% }); %>
                </select>
              </label>
              <label><span>Public update</span>
                <textarea name="message" rows="2" placeholder="e.g. We've identified the cause and are deploying a fix…" required></textarea>
              </label>
            </div>
            <div class="form-actions" style="margin-top:6px">
              <button class="btn btn-primary btn-sm" type="submit">Post update</button>
            </div>
          </form>
        </article>
        <% }); %>
      </div>
      </div>
      <% } else { %>
      <p class="muted">No incidents yet — open one above. The public page will say “All Systems Normal”.</p>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
