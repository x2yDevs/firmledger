    fence.forEach(function (chunk, idx) {
      if (idx % 2 === 1) {
        var pre = el('pre', 'wa-code');
        var nl = chunk.indexOf('\n');
        if (nl > -1 && nl < 20) chunk = chunk.slice(nl + 1);
        pre.textContent = chunk.replace(/^\s+|\s+$/g, '\n').trim();
        target.appendChild(pre);
        return;
      }
      chunk.split(/\n/).forEach(function (line) {
        if (!line.trim()) return;
        var row = el('div', 'wa-line');
        var parts = line.split(/(\*\*[^*]+\*\*|`[^`]+`|_[^_]{2,80}_)/);
        parts.forEach(function (part) {
