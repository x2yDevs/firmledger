<%- include('../partials/top') %>
<%- include('../partials/adminnav') %>

<section class="section-tight ai-page">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="klabel">Admin · Assistant</p>
        <h2>AI Playground</h2>
        <p class="muted ai-lede">Run the whole console from plain language. The assistant is a rule engine that lives on this server — no model, no API key, nothing leaves the machine. Lookups run at once; writes ask first unless you allow them under Settings, and sensitive actions always ask. Auto-moderation scores new listings the same way: deterministically, with reasons.</p>
      </div>
      <div class="ai-status-row">
        <span class="pill pill-approved">No model · no API · offline</span>
        <% if (settings.moderation_on) { %>
          <span class="pill pill-approved">Auto-moderation on</span>
        <% } else { %>
          <span class="pill pill-pending">Auto-moderation off</span>
        <% } %>
        <a class="btn btn-ghost btn-sm" href="/admin3119Musa/listings?status=pending">Review queue</a>
      </div>
    </div>

    <div class="ai-keyline">
      <span class="ai-keyline-item"><span class="ai-keyline-k">Engine</span> <b>rule-based</b> <small class="muted">(intents · slots · context)</small></span>
      <span class="ai-keyline-item"><span class="ai-keyline-k">Console actions</span> <b><%= (settings.tools || []).length %></b></span>
      <span class="ai-keyline-item"><span class="ai-keyline-k">Auto-run</span> <b><%= (settings.auto_tools || []).length %></b> <small class="muted">write actions without confirm</small></span>
      <span class="ai-keyline-item"><span class="ai-keyline-k">Assistant</span> <b>stateless · no saved history</b></span>
      <span class="ai-keyline-item ai-keyline-live"><span class="ai-keyline-k">Pending writes</span> <b><%= settings.pending_actions %></b></span>
    </div>

    <% if (ok) { %><div class="alert alert-ok" role="status"><%= ok %></div><% } %>
    <% if (err) { %><div class="alert alert-err" role="alert"><%= err %></div><% } %>

    <div class="ai-tabs" role="tablist" aria-label="AI Playground sections">
      <button type="button" class="ai-tab active" data-tab="chat" role="tab" aria-selected="true" aria-controls="pane-chat">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Admin assistant
        <% if (settings.pending_actions) { %><span class="ai-tab-badge"><%= settings.pending_actions %></span><% } %>
      </button>
      <button type="button" class="ai-tab" data-tab="set" role="tab" aria-selected="false" aria-controls="pane-set">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-2.9 1.2V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-2.9-1.2l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15H4.5a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.2-2.9l-.06-.06A2 2 0 1 1 8.57 4.2l.06.06A1.7 1.7 0 0 0 11.5 4.6V4.5a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 2.9 1.2l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 21.4 11h.1a2 2 0 1 1 0 4h-.1Z"/></svg>
        Settings &amp; logs
      </button>
    </div>

    <!-- ================= Assistant ================= -->
    <div class="ai-pane is-on" data-pane="chat" id="pane-chat" role="tabpanel" aria-label="Admin assistant">
      <div class="chat-window ai-chat" id="ai-chat">
        <header class="chat-head">
          <div class="chat-head-avatar" aria-hidden="true">FL</div>
          <div class="chat-head-meta">
            <div class="chat-head-name" id="chat-head-title">Admin assistant</div>
            <div class="chat-head-sub">
              <span class="ai-live-dot is-on" aria-hidden="true"></span>
              <span id="chat-head-sub">Online · rule engine · no model · writes confirm first</span>
            </div>
          </div>
          <div class="chat-head-actions">
            <button class="btn btn-sm btn-ghost" type="button" id="new-chat-btn" title="Clear the current assistant conversation">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              Clear chat
            </button>
            <button class="btn btn-sm btn-ghost btn-icon" type="button" id="chat-help" aria-label="How this assistant works" title="How this assistant works">?</button>
          </div>
        </header>

        <div class="ai-chat-body">
          <div class="ai-chat-main">
            <div class="chat-pane" id="chat-pane" role="log" aria-live="polite">
              <div class="chat-day">Today</div>
              <div class="wa-row wa-theirs">
                <div class="wa-bubble">
                  <div class="wa-who">Assistant</div>
                  <div class="wa-text">Hi — ask in plain language. I can read and act on everything in this console: listings, members, billing, claims, tickets, removals, blog, news, careers, promos, plans, categories, advertising, email, indexing, upkeep, status page, protection, inbox, backups and settings. Follow-ups like “approve it” or “email them” work. Lookups run immediately; writes show a confirmation first unless you auto-allow them in Settings.</div>
                </div>
              </div>
              <div class="ai-starters" role="group" aria-label="Starter prompts">
                <button type="button" class="ai-starter" data-prompt="how many pending">How many pending?</button>
                <button type="button" class="ai-starter" data-prompt="show pending listings">Pending listings</button>
                <button type="button" class="ai-starter" data-prompt="show open tickets">Open tickets</button>
                <button type="button" class="ai-starter" data-prompt="new signups this week">Signups this week</button>
                <button type="button" class="ai-starter" data-prompt="status page">Status page</button>
                <button type="button" class="ai-starter" data-prompt="show revenue">Revenue</button>
                <button type="button" class="ai-starter" data-prompt="help">What can you do?</button>
              </div>
            </div>

            <div class="chat-status-line" id="chat-status" role="status"></div>
            <div class="ai-quick" id="chat-quick" role="group" aria-label="Quick replies" hidden></div>

            <form class="chat-composer" id="chat-form">
              <div class="composer-box">
                <label class="sr-only" for="chat-input">Message the admin assistant</label>
                <textarea id="chat-input" rows="1" maxlength="4000" placeholder="e.g. approve acme and feature it · suspend bob@x.com · reply to FL-1A2B saying: on it"></textarea>
                <span class="composer-count" id="chat-count">0 / 4000</span>
              </div>
              <button class="composer-send" id="chat-send" type="submit" aria-label="Send message">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22 11 13 2 9 22 2z"/></svg>
              </button>
            </form>
            <p class="composer-hint">Enter sends · Shift+Enter for a new line · ↑ recalls your last message · nothing is stored server-side</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= Settings & logs ================= -->
    <div class="ai-pane" data-pane="set" id="pane-set" role="tabpanel" aria-label="Settings and logs">
      <div class="ai-set-grid" id="ai-settings">
        <form method="post" action="/admin3119Musa/ai/settings" class="form form-card ai-card ai-card-tight ai-set-main">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="ai_moderation_present" value="1">
          <h3 class="form-section">Auto-moderation (rule-based)</h3>
          <p class="muted ai-card-note">New pending listings are scored 0–100 from their own fields — description substance, website validity, name/domain match, category, country, duplicates, spam phrasing and your block/flag terms. No model or API is involved; every decision is written to the moderation log with its reasons.</p>
          <label class="check check-lg">
            <input type="checkbox" name="ai_moderation_on" value="1" <%= settings.moderation_on ? 'checked' : '' %>>
            <span><strong>Score every new pending listing automatically</strong><br><small class="muted">Runs in the background after dashboard, API or admin creates a listing. Anything the rules are unsure about stays pending for you. Takes precedence over the simple auto-approve toggle.</small></span>
          </label>
          <label class="check check-lg">
            <input type="checkbox" name="ai_moderation_email" value="1" <%= settings.moderation_email ? 'checked' : '' %>>
            <span><strong>Email the admin inbox when the rules are unsure</strong><br><small class="muted">Also writes an in-console notification either way.</small></span>
          </label>
          <div class="grid-2">
            <div class="ai-quick-card">
              <h4 class="ai-quick-h">Thresholds</h4>
              <p class="muted ai-card-note">Approve at or above the first score, reject at or below the second — everything between stays pending. Flagged terms and possible duplicates always stay pending.</p>
              <div class="grid-2">
                <label><span>Approve at ≥</span><input type="number" name="ai_moderation_approve_at" min="50" max="100" value="<%= settings.moderation_approve_at %>"></label>
                <label><span>Reject at ≤</span><input type="number" name="ai_moderation_reject_at" min="0" max="49" value="<%= settings.moderation_reject_at %>"></label>
              </div>
            </div>
            <div class="ai-quick-card">
              <h4 class="ai-quick-h">Review one now</h4>
              <p class="muted ai-card-note">Score one pending listing now — useful right after editing the rules or thresholds (save first). <%= pendingSamples.length %> awaiting review.<% if (!pendingSamples.length) { %> (queue is empty)<% } %></p>
              <div class="ai-quick-row">
                <label class="sr-only" for="mod-listing-id">Listing id</label>
                <input type="text" id="mod-listing-id" list="pending-ids" inputmode="numeric" pattern="[0-9]*" placeholder="listing id" maxlength="8" autocomplete="off">
                <datalist id="pending-ids">
                  <% pendingSamples.forEach(function (p) { %><option value="<%= p.id %>"><%= p.name %> · <%= p.category %></option><% }) %>
                </datalist>
                <button class="btn btn-sm btn-primary" type="button" id="mod-run-btn">Run</button>
              </div>
              <span class="muted ai-status" id="mod-status" role="status"></span>
            </div>
          </div>
          <label><span>Moderation rules <small>block: / flag: / allow-domain: — one per line</small> <span class="count" id="c-rules"></span></span>
            <textarea name="ai_moderation_rules" id="mod-rules" rows="12" maxlength="8000"><%= settings.moderation_rules %></textarea>
          </label>
          <div class="form-actions form-actions-tight">
            <button class="btn btn-xs btn-ghost" type="button" id="rules-defaults">Restore the built-in rules</button>
            <span class="muted" id="rules-defaults-hint">Replaces the text above — nothing is saved until you press Save settings.</span>
          </div>

          <h3 class="form-section">Assistant auto-run</h3>
          <p class="muted ai-card-note">Lookups always run without asking. Tick a write action to let the assistant execute it immediately. Unticked writes propose first and wait for your confirm. Sensitive actions — deletions, bulk listing changes, emailing everyone, maintenance mode, credentials and indexing resets — are locked to confirm and cannot be switched to auto-run.</p>
          <input type="hidden" name="ai_auto_tools_present" value="1">
          <div class="ai-run-summary" id="run-summary">
            <b id="run-count">0</b> write actions will run without asking
            <span class="ai-run-actions">
              <button type="button" class="btn btn-xs btn-ghost" data-run-all="1">Allow all</button>
              <button type="button" class="btn btn-xs btn-ghost" data-run-all="0">Ask for all</button>
            </span>
          </div>
          <% (settings.tool_groups || []).forEach(function (g) { %>
            <% var items = (settings.tools || []).filter(function (t) { return t.group === g.id; }); %>
            <% if (!items.length) return; %>
            <div class="ai-tool-group">
              <h4><%= g.label %> <small class="muted"><%= items.filter(function (t) { return t.mutating && !t.neverAuto; }).length %> write actions</small></h4>
              <div class="ai-tool-grid">
                <% items.forEach(function (t) { %>
                  <label class="check ai-tool-item <%= t.sensitive ? 'is-sensitive is-locked' : (t.neverAuto ? 'is-locked' : '') %> <%= !t.mutating ? 'is-read' : '' %>">
                    <input type="checkbox"
                      <% if (t.mutating && !t.neverAuto) { %>name="ai_auto_tools" value="<%= t.name %>" <%= t.auto ? 'checked' : '' %><% } else { %>disabled <%= t.auto || !t.mutating ? 'checked' : '' %><% } %>>
                    <span>
                      <strong><%= t.label %></strong>
                      <% if (t.sensitive) { %><em class="ai-tool-tag sensitive">sensitive · always confirms</em>
                      <% } else if (t.neverAuto) { %><em class="ai-tool-tag">always confirm</em>
                      <% } else if (!t.mutating) { %><em class="ai-tool-tag">lookup</em>
                      <% } %>
                      <small class="muted"><%= t.description.slice(0, 140) %></small>
                    </span>
                  </label>
                <% }) %>
              </div>
            </div>
          <% }) %>

          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Save settings</button>
            <span class="muted" id="settings-echo"></span>
          </div>
        </form>

        <div class="ai-set-side">
          <div class="form-card ai-card ai-card-tight">
            <div class="ai-card-head">
              <h3 class="form-section">Moderation log</h3>
              <div class="ai-card-head-actions">
                <label class="ai-inline-search"><span class="sr-only">Filter moderation log</span>
                  <input type="search" id="mod-log-q" placeholder="Filter…" maxlength="60" autocomplete="off">
                </label>
                <button class="btn btn-xs btn-ghost" type="button" data-refresh-log="moderation" title="Reload">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/></svg>
                </button>
              </div>
            </div>
            <p class="muted ai-card-note"><span id="mod-total"><%= moderation.total %></span> decisions recorded · newest first</p>
            <div class="table-wrap log-table-wrap" id="moderation-log-wrap" data-log="moderation" data-offset="<%= moderation.rows.length %>">
              <table class="table">
                <thead><tr><th>When</th><th>Listing</th><th>Decision</th><th>Reason</th><th>Engine</th><th></th></tr></thead>
                <tbody>
                  <% moderation.rows.forEach(function (r) { %>
                    <tr>
                      <td class="mono" style="white-space:nowrap"><%= (r.created_at || '').replace('T', ' ').slice(0, 16) %></td>
                      <td>
                        <% if (r.listing_id && r.slug) { %><a href="/admin3119Musa/listings/<%= r.listing_id %>/edit"><%= r.listing_name || r.slug %></a>
                        <% } else { %><%= r.listing_name || ('#' + r.listing_id) %><% } %>
                      </td>
                      <td><span class="status <%= r.decision === 'approve' ? 'approved' : r.decision === 'reject' ? 'rejected' : 'pending' %>"><%= r.decision %></span></td>
                      <td class="ai-cell-wrap"><%= r.reason %></td>
                      <td class="mono ai-cell-sm"><%= r.model %></td>
                      <td class="ai-row-actions">
                        <button class="btn btn-xs btn-danger log-delete-btn" type="button" data-log-type="moderation" data-log-id="<%= r.id %>" title="Delete entry" aria-label="Delete moderation entry">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"/></svg>
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <div class="log-table-footer">
              <button class="btn btn-sm btn-ghost" type="button" data-more-log="moderation" <%= moderation.has_more ? '' : 'disabled' %>>Load more</button>
              <span class="muted" data-log-shown="moderation">Showing <%= moderation.rows.length %> of <%= moderation.total %></span>
            </div>
          </div>

          <div class="form-card ai-card ai-card-tight">
            <div class="ai-card-head">
              <h3 class="form-section">Audit log</h3>
              <div class="ai-card-head-actions">
                <label class="ai-inline-search"><span class="sr-only">Filter audit log</span>
                  <input type="search" id="audit-log-q" placeholder="Filter…" maxlength="60" autocomplete="off">
                </label>
                <button class="btn btn-xs btn-ghost" type="button" data-refresh-log="audit" title="Reload">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/></svg>
                </button>
              </div>
            </div>
            <p class="muted ai-card-note">Every assistant turn, proposed action, execution, cancellation, moderation decision and settings save. <span id="audit-total"><%= auditLog.total %></span> rows.</p>
            <div class="table-wrap log-table-wrap" id="audit-log-wrap" data-log="audit" data-offset="<%= auditLog.rows.length %>">
              <table class="table">
                <thead><tr><th>When</th><th>Kind</th><th>Action</th><th>Result</th><th>OK</th><th></th></tr></thead>
                <tbody>
                  <% auditLog.rows.forEach(function (r) { %>
                    <tr>
                      <td class="mono" style="white-space:nowrap"><%= (r.created_at || '').replace('T', ' ').slice(0, 16) %></td>
                      <td><%= r.kind %></td>
                      <td class="mono ai-cell-sm"><%= r.action %></td>
                      <td class="ai-cell-wrap"><span title="<%= String(r.result || '').slice(0, 400) %>"><%= String(r.result || '').slice(0, 120) %></span></td>
                      <td><span class="status <%= r.ok ? 'approved' : 'rejected' %>"><%= r.ok ? 'yes' : 'no' %></span></td>
                      <td class="ai-row-actions">
                        <button class="btn btn-xs btn-danger log-delete-btn" type="button" data-log-type="audit" data-log-id="<%= r.id %>" title="Delete entry" aria-label="Delete audit entry">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"/></svg>
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <div class="log-table-footer">
              <button class="btn btn-sm btn-ghost" type="button" data-more-log="audit" <%= auditLog.has_more ? '' : 'disabled' %>>Load more</button>
              <span class="muted" data-log-shown="audit">Showing <%= auditLog.rows.length %> of <%= auditLog.total %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="ai-modal" id="ai-modal" hidden>
  <div class="ai-modal-card" role="dialog" aria-modal="true" aria-labelledby="ai-modal-title">
    <p class="klabel" id="ai-modal-kicker">Confirm action</p>
    <h3 id="ai-modal-title">Run this console action?</h3>
    <p class="muted" id="ai-modal-label"></p>
    <pre class="ai-modal-args" id="ai-modal-args"></pre>
    <p class="ai-modal-note">The action runs with your admin privileges. It stays valid for 10 minutes.</p>
    <div class="form-actions">
      <button class="btn btn-primary" type="button" id="ai-modal-ok">Run action</button>
      <button class="btn btn-ghost" type="button" id="ai-modal-cancel">Cancel</button>
      <span class="muted ai-status" id="ai-modal-status" role="status"></span>
    </div>
  </div>
</div>

<div class="ai-modal ai-help-modal" id="ai-help" hidden>
  <div class="ai-modal-card" role="dialog" aria-modal="true" aria-labelledby="ai-help-title">
    <p class="klabel">Admin assistant</p>
    <h3 id="ai-help-title">How this assistant works</h3>
    <ul class="ai-help-list">
      <li><b>No model, no API.</b> Your message is normalised, matched against intent rules and synonyms, and the ids, emails, names, statuses and durations in it are pulled out. Everything runs on this server.</li>
      <li><b>It knows the whole console.</b> Listings, members &amp; billing, claims, tickets, removals, blog, news, careers, promos, plans, categories, advertising, email, indexing, upkeep, status page, protection &amp; rate limits, inbox, backups and settings — <%= (settings.tools || []).length %> actions.</li>
      <li><b>Reads run straight away.</b> Counts, lookups and status checks never change anything.</li>
      <li><b>Writes are confirmed.</b> A proposal card shows the exact arguments; nothing executes until you press Run — unless you allow that action under Settings → Assistant auto-run.</li>
      <li><b>Sensitive actions always ask.</b> Deletions, bulk listing actions, emailing everyone, maintenance mode, credentials and index resets are confirmed every time.</li>
      <li><b>Context carries over.</b> After “show acme”, say “approve it”, “feature it”, “email the owner”. After a list, “the first one” or “#42” picks an item.</li>
      <li><b>It asks when unsure.</b> Two members called Bob? You get a numbered choice. Missing a subject line? It asks for just that.</li>
      <li><b>Chains work.</b> “approve 42 and feature it, then email the owner” runs in order; several writes arrive as one numbered confirmation.</li>
      <li><b>Only real results are reported.</b> Every reply comes from the action's actual return value — a failed action is reported as failed.</li>
      <li><b>No saved history.</b> The visible conversation in this tab is the only context; reloading starts fresh.</li>
    </ul>
    <div class="form-actions">
      <button class="btn btn-primary" type="button" id="ai-help-close">Got it</button>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var CSRF = <%- JSON.stringify(csrfToken || '') %>;
  var BASE = '/admin3119Musa/ai';
  var START_TAB = <%- JSON.stringify(tab) %>;
  var DEFAULT_RULES = <%- JSON.stringify(settings.default_rules) %>;

  /* ---------------- tiny helpers ---------------- */

  function $(id) { return document.getElementById(id); }
  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = String(text);
    return n;
  }
  function svg(paths, size, fill) {
    var s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    s.setAttribute('viewBox', '0 0 24 24');
    s.setAttribute('width', String(size || 13));
    s.setAttribute('height', String(size || 13));
    s.setAttribute('fill', fill || 'none');
    s.setAttribute('stroke', 'currentColor');
    s.setAttribute('stroke-width', '2');
    s.setAttribute('stroke-linecap', 'round');
    s.setAttribute('stroke-linejoin', 'round');
    s.setAttribute('aria-hidden', 'true');
    paths.forEach(function (d) {
      var p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      p.setAttribute('d', d);
      s.appendChild(p);
    });
    return s;
  }
  function toast(kind, msg, title) {
    if (window.__flToast) window.__flToast(kind, msg, title);
  }
  function icoBtn(label, paths, cls) {
    var b = el('button', 'icon-btn xs ' + (cls || ''));
    b.type = 'button';
    b.title = label;
    b.setAttribute('aria-label', label);
    b.appendChild(svg(paths, 13));
    return b;
  }
  function store(key, value) {
    try {
      if (value === undefined) return window.localStorage.getItem(key);
      window.localStorage.setItem(key, value);
    } catch (e) { /* private mode — the page still works */ }
    return null;
  }
  /* ---------------- fetch wrapper ---------------- */

