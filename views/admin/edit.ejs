<%- include('../partials/top') %>
<%- include('../partials/adminnav') %>

<section class="section-tight">
  <div class="container container-narrow">
    <div class="section-head">
      <h2>Edit — <%= l.name %></h2>
      <a class="btn btn-ghost btn-sm" href="/listing/<%= l.slug %>" target="_blank">View public profile ↗</a>
    </div>

    <form method="post" action="/admin3119Musa/listings/<%= l.id %>/edit" class="form form-card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <h3 class="form-section">Moderation</h3>
      <div class="grid-3">
        <label><span>Status</span>
          <select name="status">
            <% ['pending', 'approved', 'rejected'].forEach(function (s) { %><option value="<%= s %>" <%= l.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
          </select>
        </label>
        <label><span>Confidence (0–97)</span>
          <input type="number" name="confidence" min="0" max="97" value="<%= l.confidence %>">
        </label>
        <label><span>Last verified at</span>
          <input type="text" name="last_verified_at" value="<%= l.last_verified_at || '' %>" placeholder="ISO date or blank">
        </label>
      </div>
      <div class="check-row">
        <label class="check"><input type="checkbox" name="featured" value="1" <%= l.featured ? 'checked' : '' %>><span>Featured</span></label>
        <label class="check"><input type="checkbox" name="claimed" value="1" <%= l.claimed ? 'checked' : '' %>><span>Claimed (verified owner)</span></label>
      </div>

      <h3 class="form-section">Identity</h3>
      <label><span>Name</span><input type="text" name="name" value="<%= l.name %>" required></label>
      <label><span>Tagline</span><input type="text" name="tagline" value="<%= l.tagline %>"></label>
      <label><span>Description</span><textarea name="description" rows="5"><%= l.description %></textarea></label>
      <div class="grid-3">
        <label><span>Type</span>
          <select name="type"><% TYPES.forEach(function (t) { %><option value="<%= t.value %>" <%= l.type === t.value ? 'selected' : '' %>><%= t.label %></option><% }) %></select>
        </label>
        <label><span>Category (pick or create)</span>
          <input type="text" name="category" list="adminCategoryList" maxlength="40" value="<%= l.category %>" autocomplete="off">
          <datalist id="adminCategoryList"><% allCats.forEach(function (c) { %><option value="<%= c.name %>"><% }) %></datalist>
        </label>
        <label><span>Tags</span><input type="text" name="tags" value="<%= l.tags %>"></label>
      </div>

      <h3 class="form-section">Logo — uniform 256 × 256</h3>
      <div class="logo-row">
        <div class="logo-preview">
          <% if (l.logo_url) { %><img src="<%= l.logo_url %>" alt="<%= l.name %> logo"><% } else { %><span class="logo-tile"><%= l.name.slice(0, 1) %></span><% } %>
        </div>
        <div class="logo-controls">
          <label><span>Logo URL <small class="muted">direct link to a PNG, JPG, WebP or SVG</small></span>
            <input type="text" name="logo_url" value="<%= (l.logo_url || '').startsWith('/uploads') ? '' : (l.logo_url || '') %>" placeholder="https://…/logo.png"></label>
          <% if (l.logo_url) { %><label class="check"><input type="checkbox" name="remove_logo" value="1"><span>Remove current</span></label><% } %>
        </div>
      </div>

      <h3 class="form-section">Contact &amp; facts</h3>
      <div class="grid-3">
        <label><span>Website</span><input type="text" name="website" value="<%= l.website %>"></label>
        <label><span>Founded</span><input type="text" name="founded" value="<%= l.founded %>"></label>
        <label><span>Size</span><input type="text" name="size" value="<%= l.size %>"></label>
      </div>
      <div class="grid-3">
        <label><span>Country</span><input type="text" name="country" value="<%= l.country %>"></label>
        <label><span>City</span><input type="text" name="city" value="<%= l.city %>"></label>
        <label><span>Region / County</span><input type="text" name="region" value="<%= l.region %>"></label>
      </div>
      <div class="grid-3">
        <label><span>Email</span><input type="text" name="email" value="<%= l.email %>"></label>
        <label><span>Phone</span><input type="text" name="phone" value="<%= l.phone %>"></label>
        <label><span>Address</span><input type="text" name="address" value="<%= l.address %>"></label>
      </div>

      <h3 class="form-section">Sources (one URL per line)</h3>
      <label><span class="sr-only">Sources</span>
        <textarea name="sources" rows="4" placeholder="https://registry.example/…&#10;https://wikipedia.org/wiki/…"><%= sources %></textarea>
      </label>

      <div class="form-actions">
        <button class="btn btn-primary btn-lg" type="submit">Save changes</button>
        <a class="btn btn-ghost" href="/admin3119Musa/listings">Back</a>
      </div>
    </form>

    <div class="form-card" id="tech">
      <h3 class="form-section">Technology radar</h3>
      <% if (typeof ok !== 'undefined' && ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
      <% if (typeof err !== 'undefined' && err) { %><div class="alert alert-err"><%= err %></div><% } %>
      <p class="muted" style="font-size:13.5px;margin-bottom:12px">
        Detected from the company's own public homepage — frameworks, CMS, payments, analytics and
        hosting signatures, plus any careers link it can find. Shown on the public profile.
      </p>
      <% if (tech.length) { %>
        <div class="tech-chips">
          <% tech.forEach(function (t) { %><span class="tech-chip"><b><%= t.n %></b><small><%= t.c %></small></span><% }) %>
        </div>
      <% } else { %>
        <p class="muted">No technologies detected yet.</p>
      <% } %>
      <div class="jf-row" style="margin-top:14px;align-items:center">
        <form method="post" action="/admin3119Musa/listings/<%= l.id %>/refresh-tech">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="back" value="edit">
          <button class="btn btn-primary btn-sm" type="submit" <%= l.website ? '' : 'disabled' %>>Refresh now</button>
        </form>
        <span class="muted" style="font-size:13.5px">
          <%= techCheckedAt ? 'Last scanned ' + techCheckedAt : 'Never scanned' %><% if (l.hiring_url) { %> · hiring link found<% } %>
        </span>
      </div>
      <% if (!l.website) { %><p class="form-note">Add a website to this listing — the scan reads the public homepage.</p><% } %>
    </div>

    <div class="form-card" id="news">
      <h3 class="form-section">News about this company</h3>
      <p class="muted" style="font-size:13.5px;margin-bottom:12px">
        Stories shown on the public profile. Detected stories have to name this company or sit on its own domain;
        member submissions wait here until someone approves them.
        <% if (newsCheckedAt) { %><br><small class="muted">Last checked for news: <%= newsCheckedAt %></small><% } else { %><br><small class="muted">Never checked for news.</small><% } %>
      </p>

      <form method="post" action="/admin3119Musa/news/refresh" class="inline" style="margin-bottom:14px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="scope" value="selected">
        <input type="hidden" name="ids" value="<%= l.id %>">
        <button class="btn btn-primary btn-sm" type="submit" <%= l.name ? '' : 'disabled' %>>Look for stories now</button>
        <a class="btn btn-ghost btn-sm" href="/admin3119Musa/news">Full news queue →</a>
      </form>

      <% if (newsItems.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Story</th><th>Origin</th><th>Status</th><th class="ta-right">Moderate</th></tr></thead>
            <tbody>
              <% newsItems.forEach(function (n) { %>
                <tr>
                  <td style="max-width:380px">
                    <% if (n.url) { %><a href="<%= n.url %>" target="_blank" rel="noopener nofollow"><strong><%= n.title %></strong></a><% } else { %><strong><%= n.title %></strong><% } %>
                    <br><small class="muted"><%= n.source || 'no publication' %><% if (n.published_at) { %> · <%= n.published_at %><% } %></small>
                  </td>
                  <td><small class="muted"><%= newsOriginLabel(n) %></small></td>
                  <td><span class="pill pill-<%= n.status %>"><%= n.status %></span></td>
                  <td class="ta-right actions-cell">
                    <% if (n.status !== 'approved') { %>
                    <form method="post" action="/admin3119Musa/news/<%= n.id %>/approve" class="inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-primary btn-xs" type="submit">Approve</button>
                    </form>
                    <% } %>
                    <% if (n.status !== 'rejected') { %>
                    <form method="post" action="/admin3119Musa/news/<%= n.id %>/reject" class="inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-ghost btn-xs" type="submit">Reject</button>
                    </form>
                    <% } %>
                    <form method="post" action="/admin3119Musa/news/<%= n.id %>/delete" class="inline" onsubmit="return confirm('Delete this story permanently?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-danger btn-xs" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %><p class="muted">No stories yet.</p><% } %>

      <form method="post" action="/admin3119Musa/news/add" class="form" style="margin-top:16px;border-top:1px solid var(--hair);padding-top:14px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="listing_id" value="<%= l.id %>">
        <div class="grid-3">
          <label><span>Published on</span><input type="date" name="published_at" max="<%= todayIso %>"></label>
          <label><span>Publication</span><input type="text" name="source" maxlength="80" placeholder="e.g. Business Daily"></label>
          <label><span>Link</span><input type="url" name="url" maxlength="500" placeholder="https://…"></label>
        </div>
        <label style="margin-top:10px"><span>Headline *</span>
          <input type="text" name="title" required maxlength="220" placeholder="e.g. Raises Sh200m to expand across East Africa">
        </label>
        <div class="form-actions" style="margin-top:12px"><button class="btn btn-primary btn-sm" type="submit">Publish story</button></div>
      </form>
    </div>

    <div class="form-card" id="ownership">
      <h3 class="form-section">Ownership — make anyone the owner, or remove the owner</h3>
      <% if (typeof ok !== 'undefined' && ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
      <% if (typeof err !== 'undefined' && err) { %><div class="alert alert-err"><%= err %></div><% } %>
      <p class="muted" style="font-size:13.5px;margin-bottom:12px">Transfer this listing to any account, or clear the owner to return it to unclaimed. Removing the owner also clears the verified flag.</p>
      <form method="post" action="/admin3119Musa/listings/<%= l.id %>/owner">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input class="input" type="search" data-filter-for="#ownerPicker" data-filter-note="ownerPickerNote"
               placeholder="Filter members by name or email…" aria-label="Filter the member list" maxlength="80"
               style="margin-bottom:8px">
        <div class="jf-row">
          <select name="owner_user_id" id="ownerPicker">
            <option value="0">— No owner (unclaimed) —</option>
            <% ownerOptions.forEach(function (u) { %>
            <option value="<%= u.id %>" <%= l.owner_user_id === u.id ? 'selected' : '' %>><%= (u.name || u.email) %> — <%= u.email %></option>
            <% }); %>
          </select>
          <button class="btn btn-primary" type="submit">Set owner</button>
        </div>
        <small class="muted" id="ownerPickerNote" style="display:block;margin-top:4px"></small>
      </form>
    </div>

    <%- include('../partials/relations', { relations, REL_TYPES, actionUrl: '/admin3119Musa/listings/' + l.id, deleteUrl: '/admin3119Musa/relations', csrfToken }) %>

    <div class="form-card" id="timeline">
      <h3 class="form-section">Timeline events</h3>
      <% if (events.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Date</th><th>Kind</th><th>Event</th><th></th></tr></thead>
            <tbody>
              <% events.forEach(function (e) { %>
                <tr>
                  <td><code><%= e.event_date %></code></td>
                  <td><span class="pill pill-type"><%= e.kind %></span></td>
                  <td><%= e.title %></td>
                  <td class="ta-right">
                    <form method="post" action="/admin3119Musa/events/<%= e.id %>/delete" class="inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-danger btn-xs" type="submit">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %><p class="muted">No events yet.</p><% } %>
      <form method="post" action="/admin3119Musa/listings/<%= l.id %>/events" class="form event-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid-3">
          <label><span>Date</span><input type="text" name="event_date" placeholder="2024-06" required></label>
          <label><span>Kind</span>
            <select name="kind">
              <% ['founded', 'funding', 'product', 'leadership', 'acquisition', 'milestone'].forEach(function (k) { %><option value="<%= k %>"><%= k %></option><% }) %>
            </select>
          </label>
          <label><span>Event</span><input type="text" name="title" placeholder="Seed round closed" required></label>
        </div>
        <button class="btn btn-ghost" type="submit">+ Add event</button>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
