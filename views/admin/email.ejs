<%- include('../partials/top') %>
<%- include('../partials/adminnav') %>

<section class="section-tight">
  <div class="container admin-form-cap">
    <div class="section-head">
      <h2>Email members</h2>
    </div>

    <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
      <div class="alert alert-err"><strong>Can't send yet:</strong><% errors.forEach(function (e) { %><div>· <%= e %></div><% }) %></div>
    <% } %>

    <form method="post" action="/admin3119Musa/email" class="form form-card" id="mailForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label><span>To</span>
        <select name="to" id="mailTo" required>
          <option value="">Choose a recipient…</option>
          <optgroup label="Audience groups">
            <option value="all" <%= preset === 'all' ? 'selected' : '' %>>All users (<%= counts.all %>)</option>
            <option value="pro" <%= preset === 'pro' ? 'selected' : '' %>>All Pro members (<%= counts.pro %>)</option>
            <option value="free" <%= preset === 'free' ? 'selected' : '' %>>All Free accounts (<%= counts.free %>)</option>
            <option value="newsletter" <%= preset === 'newsletter' ? 'selected' : '' %>>Newsletter subscribers (digest list) (<%= counts.newsletter %>)</option>
            <option value="nl_guests" <%= preset === 'nl_guests' ? 'selected' : '' %>>Guest-only subscribers — emails without accounts (<%= counts.nl_guests %>)</option>
          </optgroup>
          <optgroup label="Individual users" id="mailUsers">
          <% users.forEach(function (u) { %>
          <option value="<%= u.email %>" <%= preset === u.email ? 'selected' : '' %>><%= u.name %> · <%= u.email %></option>
          <% }) %>
          </optgroup>
        </select>
      </label>
      <label><span>Find a member</span>
        <div class="suggest-box">
          <input class="input" type="search" id="mailUserQ" placeholder="Search name or email…" autocomplete="off" maxlength="80">
          <ul class="suggest-list" id="mailUserResults" hidden></ul>
        </div>
      </label>
      <script>
      (function () {
        var q = document.getElementById('mailUserQ');
        var list = document.getElementById('mailUserResults');
        var sel = document.getElementById('mailTo');
        if (!q || !list || !sel) return;
        var t = null;
        function pick(u) {
          var exists = Array.prototype.some.call(sel.options, function (o) { return o.value === u.email; });
          if (!exists) {
            var opt = document.createElement('option');
            opt.value = u.email;
            opt.textContent = u.name + ' · ' + u.email;
            document.getElementById('mailUsers').appendChild(opt);
          }
          sel.value = u.email;
          q.value = u.name + ' · ' + u.email;
          list.hidden = true;
        }
        function paint(rows) {
          list.innerHTML = '';
          if (!rows || !rows.length) { list.hidden = true; return; }
          rows.forEach(function (u) {
            var li = document.createElement('li');
            li.innerHTML = '<span>' + String(u.name || '').replace(/</g,'') + '</span><span class="suggest-cat">' + String(u.email || '').replace(/</g,'') + '</span>';
            li.addEventListener('mousedown', function (e) { e.preventDefault(); pick(u); });
            list.appendChild(li);
          });
          list.hidden = false;
        }
        q.addEventListener('input', function () {
          clearTimeout(t);
          t = setTimeout(function () {
            fetch('/admin3119Musa/email/users.json?q=' + encodeURIComponent(q.value.trim()), { credentials: 'same-origin' })
              .then(function (r) { return r.json(); })
              .then(function (d) { paint(d.users || []); })
              .catch(function () { list.hidden = true; });
          }, 180);
        });
        q.addEventListener('blur', function () { setTimeout(function () { list.hidden = true; }, 180); });
      })();
      </script>
      <label><span>Subject (prefixed with “[FirmLedger]”)</span>
        <input type="text" name="subject" maxlength="200" required placeholder="e.g. Claim your listing — verification now takes minutes" value="<%= typeof draft !== 'undefined' && draft ? draft.subject : '' %>">
      </label>
      <label><span>Format</span>
        <select name="format" id="mailFormat">
          <option value="text" <%= (typeof draft !== 'undefined' && draft && draft.format === 'html') ? '' : 'selected' %>>Plain text — simple letter, fastest to write</option>
          <option value="html" <%= (typeof draft !== 'undefined' && draft && draft.format === 'html') ? 'selected' : '' %>>Branded HTML — FirmLedger design, with logo header</option>
        </select>
      </label>
      <label><span>Message</span>
        <textarea name="body" id="mailBody" rows="12" required placeholder="Hello — a quick note from the FirmLedger moderation team…"><%= typeof draft !== 'undefined' && draft ? draft.body : '' %></textarea>
      </label>
      <p class="fine-print" id="fmtHint" style="margin-top:-6px">Plain text is sent exactly as written (newlines preserved).</p>
      <script>
      (function () {
        var f = document.getElementById('mailFormat'), h = document.getElementById('fmtHint'), ta = document.getElementById('mailBody');
        f.addEventListener('change', function () {
          if (f.value === 'html') {
            h.textContent = 'HTML mode — your message becomes the body of the branded FirmLedger email (paragraphs = blank lines). You can use <b>, <a href>, <strong>, <em>, lists.';
            ta.placeholder = 'Hello {{name}},\n\nWe\'re launching…\n\n    <b>Bold point</b> — and a <a href="https://firmledger.co.ke">link</a>.';
          } else {
            h.textContent = 'Plain text is sent exactly as written (newlines preserved).';
            ta.placeholder = 'Hello — a quick note from the FirmLedger moderation team…';
          }
        });
      })();
      </script>
      <div class="form-actions" style="align-items:center">
        <button class="btn btn-primary" type="submit">Send</button>
        <span class="fine-print" id="mailHint"><% if (smtp) { %>Delivered via SMTP (SMTP_URL).<% } else { %>No SMTP_URL configured — messages are written to data/outbox.log instead of being delivered.<% } %></span>
      </div>
    </form>

    <div class="section-head" style="margin-top:2.5rem"><h2>Recent sends</h2><span class="muted"><%= log.length %></span></div>
    <% if (log.length) { %>
    <div class="scroll-table">
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>To</th><th>Subject</th><th>Status</th><th>Sent</th></tr></thead>
          <tbody>
            <% log.forEach(function (m) { %>
            <tr>
              <td><small class="mono"><%= m.to_email %></small></td>
              <td><strong><%= m.subject %></strong></td>
              <td><span class="pill pill-<%= m.delivered ? 'approved' : 'pending' %>"><%= m.delivered ? 'delivered' : 'outbox' %></span></td>
              <td class="muted"><%= fmtDate(m.created_at) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } else { %><p class="muted">No messages sent yet.</p><% } %>
  </div>
</section>

<%- include('../partials/bottom') %>
