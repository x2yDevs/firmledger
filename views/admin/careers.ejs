<%- include('../partials/top') %>
<%- include('../partials/adminnav') %>

<section class="section-tight">
  <div class="container">
    <div class="section-head">
      <h2>Careers</h2>
      <p class="muted" style="font-size:14px">Manage FirmLedger's own open roles. They appear on the public <a href="/careers">/careers</a> page and in the RSS feed. If there are none, the page says “We're not hiring”.</p>
    </div>

    <% if (typeof ok !== 'undefined' && ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
    <% if (typeof err !== 'undefined' && err) { %><div class="alert alert-err"><%= err %></div><% } %>
    <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
      <div class="alert alert-err"><% errors.forEach(function (e) { %><div><%= e %></div><% }); %></div>
    <% } %>

    <div class="form-card">
      <h3 class="form-section">Post a role</h3>
      <form class="form" method="post" action="/admin3119Musa/careers">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid-2">
          <label><span>Job title *</span><input type="text" name="title" placeholder="e.g. Full-stack Engineer" required maxlength="140" value="<%= typeof old !== 'undefined' && old.title ? old.title : '' %>"></label>
          <label><span>Role type</span>
            <select name="role_type">
              <% ROLE_TYPES.forEach(function (t) { %>
              <option value="<%= t %>" <%= typeof old !== 'undefined' && old.role_type === t ? 'selected' : '' %>><%= t %></option>
              <% }); %>
            </select>
          </label>
        </div>
        <div class="grid-2">
          <label><span>Location *</span><input type="text" name="location" placeholder="Nairobi, or Remote" required maxlength="120" value="<%= typeof old !== 'undefined' && old.location ? old.location : '' %>"></label>
          <label><span>Apply-to email</span><input type="email" name="apply_email" placeholder="careers@firmledger.co.ke" value="<%= typeof old !== 'undefined' && old.apply_email ? old.apply_email : 'careers@firmledger.co.ke' %>"></label>
        </div>
        <label><span>Role description</span><textarea name="description" rows="5" placeholder="A few sentences about the role — separate paragraphs with blank lines. Shown on the public /careers page."><%= typeof old !== 'undefined' && old.description ? old.description : '' %></textarea></label>
        <label><span>Requirements — one per line</span><textarea name="requirements" rows="4" placeholder="e.g. 4+ years building production web apps&#10;Strong SQL and API design skills"><%= typeof old !== 'undefined' && old.requirements ? old.requirements : '' %></textarea></label>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit">Publish role</button>
          <span class="fine-print" style="margin:0">Published roles appear instantly on <a href="/careers">/careers</a> and in the site feed.</span>
        </div>
      </form>
    </div>

    <div class="side-card">
      <h3>Roles</h3>
      <% if (roles.length) { %>
      <div class="scroll-table">
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Title</th><th>Type</th><th>Location</th><th>Status</th><th class="ta-right">Actions</th></tr></thead>
            <tbody>
              <% roles.forEach(function (r) { %>
              <tr>
                <td><strong><%= r.title %></strong><br><small class="muted">posted <%= fmtDate(r.created_at) %></small></td>
                <td><%= r.role_type %></td>
                <td><%= r.location %></td>
                <td><span class="pill pill-<%= r.status === 'open' ? 'approved' : 'closed' %>"><%= r.status %></span></td>
                <td class="ta-right actions-cell">
                  <a class="btn btn-ghost btn-xs" href="/careers#role-<%= r.id %>" target="_blank">View</a>
                  <form method="post" action="/admin3119Musa/careers/<%= r.id %>/toggle" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-ghost btn-xs" type="submit"><%= r.status === 'open' ? 'Close' : 'Reopen' %></button>
                  </form>
                  <form method="post" action="/admin3119Musa/careers/<%= r.id %>/delete" class="inline" onsubmit="return confirm('Remove role “<%= r.title.replace(/\"/g, '') %>”?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-danger btn-xs" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
      <% } else { %>
      <p class="muted">No roles yet — post one above. The public page will say “We're not hiring”.</p>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
