<%- include('../partials/top') %>
<%- include('../partials/adminnav') %>

<section class="section-tight">
  <div class="container">
    <div class="section-head">
      <h2>Search the console</h2>
    </div>
    <form class="form" method="get" action="/admin3119Musa/search" style="max-width:640px;margin-bottom:1.6rem">
      <label><span>Users, listings, claims, tickets, blog</span>
        <div class="search-hero">
          <input class="input search-hero-in" type="search" name="q" value="<%= q || '' %>" placeholder="Name, email, slug, ticket ref…" maxlength="80" autofocus>
          <button class="btn btn-gold" type="submit">Search</button>
        </div>
      </label>
    </form>

    <% if (!q || q.length < 2) { %>
      <p class="muted">Type at least two characters.</p>
    <% } else { %>
      <% const r = results; %>
      <p class="search-count"><%= r.users.length + r.listings.length + r.claims.length + r.tickets.length + r.posts.length %> matches for “<%= q %>”</p>

      <div class="search-groups">
        <div class="search-group">
          <h3>Users <span class="sg-n"><%= r.users.length %></span></h3>
          <% if (!r.users.length) { %><p class="muted">None.</p><% } %>
          <% r.users.forEach(function (u) { %>
            <a class="search-row" href="/admin3119Musa/users/<%= u.id %>">
              <span class="ph"><%= (u.name || 'U').slice(0,1).toUpperCase() %></span>
              <span class="sr-t"><b><%= u.name %></b><small><%= u.email %><%= u.suspended ? ' · suspended' : '' %></small></span>
              <span class="sr-arrow">→</span>
            </a>
          <% }) %>
        </div>
        <div class="search-group">
          <h3>Listings <span class="sg-n"><%= r.listings.length %></span></h3>
          <% if (!r.listings.length) { %><p class="muted">None.</p><% } %>
          <% r.listings.forEach(function (l) { %>
            <a class="search-row" href="/admin3119Musa/listings/<%= l.id %>/edit">
              <span class="ph"><%= l.name.slice(0,1) %></span>
              <span class="sr-t"><b><%= l.name %></b><small><%= l.status %><%= l.claimed ? ' · claimed' : '' %> · <%= l.category %></small></span>
              <span class="sr-arrow">→</span>
            </a>
          <% }) %>
        </div>
        <div class="search-group">
          <h3>Claims <span class="sg-n"><%= r.claims.length %></span></h3>
          <% if (!r.claims.length) { %><p class="muted">None.</p><% } %>
          <% r.claims.forEach(function (c) { %>
            <a class="search-row" href="/admin3119Musa/claims">
              <span class="ph">C</span>
              <span class="sr-t"><b><%= c.listing_name %></b><small><%= c.user_email %> · <%= c.method %> · <%= c.status %></small></span>
              <span class="sr-arrow">→</span>
            </a>
          <% }) %>
        </div>
        <div class="search-group">
          <h3>Tickets <span class="sg-n"><%= r.tickets.length %></span></h3>
          <% if (!r.tickets.length) { %><p class="muted">None.</p><% } %>
          <% r.tickets.forEach(function (t) { %>
            <a class="search-row" href="/admin3119Musa/tickets/<%= t.id %>">
              <span class="ph">T</span>
              <span class="sr-t"><b><%= t.subject %></b><small><%= t.ref %> · <%= t.user_email %> · <%= t.status %></small></span>
              <span class="sr-arrow">→</span>
            </a>
          <% }) %>
        </div>
        <div class="search-group">
          <h3>Blog <span class="sg-n"><%= r.posts.length %></span></h3>
          <% if (!r.posts.length) { %><p class="muted">None.</p><% } %>
          <% r.posts.forEach(function (p) { %>
            <a class="search-row" href="/admin3119Musa/blog/<%= p.id %>/edit">
              <span class="ph">B</span>
              <span class="sr-t"><b><%= p.title %></b><small>/blog/<%= p.slug %> · <%= p.status %></small></span>
              <span class="sr-arrow">→</span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/bottom') %>
