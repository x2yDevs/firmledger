<%- include('../partials/top') %>
<%- include('../partials/adminnav') %>

<section class="section-tight">
  <div class="container">
    <div class="stat-cards">
      <div class="stat-card"><span class="stat-num"><%= stats.pending %></span><span class="stat-label">Pending review</span><a href="/admin3119Musa/listings?status=pending">Review →</a></div>
      <div class="stat-card"><span class="stat-num"><%= stats.approved %></span><span class="stat-label">Live listings</span><a href="/admin3119Musa/listings?status=approved">View →</a></div>
      <div class="stat-card"><span class="stat-num"><%= stats.claimed %></span><span class="stat-label">Claimed &amp; verified</span></div>
      <div class="stat-card"><span class="stat-num"><%= stats.users %></span><span class="stat-label">Registered users</span><a href="/admin3119Musa/users">View →</a></div>
      <div class="stat-card"><span class="stat-num"><%= stats.pendingClaims %></span><span class="stat-label">Open claims</span><a href="/admin3119Musa/claims">Review →</a></div>

      <div class="stat-card"><span class="stat-num"><%= stats.pendingRemovals %></span><span class="stat-label">Removal requests</span><a href="/admin3119Musa/removals">Resolve →</a></div>
      <div class="stat-card"><span class="stat-num"><%= stats.suspended %></span><span class="stat-label">Suspended users</span><a href="/admin3119Musa/users">Manage →</a></div>
      <div class="stat-card"><span class="stat-num"><%= stats.posts %></span><span class="stat-label">Blog posts</span><a href="/admin3119Musa/blog">Write →</a></div>
      <div class="stat-card"><span class="stat-num"><%= stats.openTickets || 0 %></span><span class="stat-label">Open tickets</span><a href="/admin3119Musa/tickets?filter=open">Queue →</a></div>
      <div class="stat-card"><span class="stat-num"><%= stats.pendingDeletions || 0 %></span><span class="stat-label">Deletion requests</span><a href="/admin3119Musa/users">Review →</a></div>
      <div class="stat-card"><span class="stat-num"><%= stats.sponsored || 0 %></span><span class="stat-label">Sponsored spots</span><a href="/admin3119Musa/advertising">Manage →</a></div>
      <div class="stat-card"><span class="stat-num"><%= stats.careersOpen || 0 %></span><span class="stat-label">Open roles</span><a href="/admin3119Musa/careers">Careers →</a></div>
      <div class="stat-card"><span class="stat-num"><%= stats.techStale || 0 %></span><span class="stat-label">Stale tech scans</span><a href="/admin3119Musa/listings?tech=stale">Review →</a></div>
    </div>

    <% var tj = typeof techJob !== 'undefined' ? techJob : { running: false }; %>
    <% if ((stats.techStale || 0) > 0 || tj.running) { %>
      <div class="side-card" id="tech-maintenance" style="margin-top:18px">
        <h3>Technology radar maintenance</h3>
        <p class="muted" style="margin-bottom:12px">
          <% if (tj.running) { %>
            A refresh run is in progress — <%= tj.done %> of <%= tj.total %> scanned, <%= tj.changed %> changed.
          <% } else { %>
            <strong><%= stats.techStale %></strong> listing<%= stats.techStale === 1 ? '' : 's' %> with a website
            <%= stats.techStale === 1 ? 'has' : 'have' %> a technology snapshot that is missing or older than
            <%= techStaleDays %> days (<%= stats.techNever || 0 %> never scanned).
          <% } %>
        </p>
        <form method="post" action="/admin3119Musa/listings/refresh-tech" class="bulk-bar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (tj.running) { %>
            <a class="btn btn-ghost btn-sm" href="/admin3119Musa/listings#tech-maintenance">Watch progress →</a>
          <% } else { %>
            <button class="btn btn-primary btn-sm" type="submit" name="scope" value="stale">Refresh <%= stats.techStale %> stale</button>
            <a class="btn btn-ghost btn-sm" href="/admin3119Musa/listings#tech-maintenance">All options →</a>
          <% } %>
        </form>
      </div>
    <% } %>

    <div class="section-head" style="margin-top:2.5rem"><h2>Recent submissions</h2></div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Listing</th><th>Type</th><th>Status</th><th>Confidence</th><th>Submitted</th><th class="ta-right">Actions</th></tr></thead>
        <tbody>
          <% recent.forEach(function (l) { %>
            <tr>
              <td><strong><%= l.name %></strong></td>
              <td><span class="pill pill-type"><%= l.type %></span></td>
              <td><span class="pill pill-<%= l.status %>"><%= l.status %></span></td>
              <td><span class="conf"><i style="width:<%= l.confidence %>%"></i></span> <span class="conf-num"><%= l.confidence %></span></td>
              <td class="muted"><%= fmtDate(l.created_at) %></td>
              <td class="ta-right actions-cell">
                <a class="btn btn-ghost btn-xs" href="/admin3119Musa/listings/<%= l.id %>/edit">Edit</a>
                <% if (l.status !== 'approved') { %>
                  <form method="post" action="/admin3119Musa/listings/<%= l.id %>/approve" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-primary btn-xs" type="submit">Approve</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
