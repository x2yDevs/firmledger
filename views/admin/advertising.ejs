<%- include('../partials/top') %>
<%- include('../partials/adminnav') %>

<section class="section-tight">
  <div class="container">
    <div class="section-head">
      <h2>Advertising — Sponsored Content</h2>
      <p class="muted" style="font-size:14px">Users buy these packages to place a listing on the homepage Sponsored Content strip. You can also sponsor or remove any listing directly.</p>
    </div>

    <% if (typeof ok !== 'undefined' && ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
    <% if (typeof err !== 'undefined' && err) { %><div class="alert alert-err"><%= err %></div><% } %>

    <div class="form-card">
      <h3 class="form-section">Add a package</h3>
      <form class="form" method="post" action="/admin3119Musa/advertising/packages">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid-2">
          <label><span>Package name *</span><input type="text" name="name" placeholder="e.g. Featured Spotlight — 30 days" required maxlength="60"></label>
          <label><span>Short blurb (shown on /advertise)</span><input type="text" name="blurb" placeholder="A month of homepage Sponsored Content placement." maxlength="240"></label>
        </div>
        <div class="grid-3">
          <label><span>Price (USD) *</span><input type="number" name="price_usd" placeholder="40.00" step="0.01" min="0.01" inputmode="decimal" required></label>
          <label><span>Duration (days) *</span><input type="number" name="duration_days" placeholder="30" min="1" max="3650" inputmode="numeric" required></label>
          <label><span>Sort order</span><input type="number" name="sort" placeholder="1" min="0" inputmode="numeric"></label>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit">Create package</button>
        </div>
      </form>

      <% if (packages.length) { %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Name</th><th>Price</th><th>Duration</th><th>State</th><th class="ta-right">Actions</th></tr></thead>
          <tbody>
            <% packages.forEach(function (p) { %>
            <tr>
              <td><strong><%= p.name %></strong><br><small class="muted"><%= p.blurb %></small></td>
              <td>$<%= (p.price_cents / 100).toFixed(2) %></td>
              <td><%= p.duration_days %> days</td>
              <td><span class="pill pill-<%= p.active ? 'approved' : 'rejected' %>"><%= p.active ? 'live' : 'hidden' %></span></td>
              <td class="ta-right actions-cell">
                <form method="post" action="/admin3119Musa/advertising/packages/<%= p.id %>/toggle" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-ghost btn-xs" type="submit"><%= p.active ? 'Hide' : 'Publish' %></button>
                </form>
                <form method="post" action="/admin3119Musa/advertising/packages/<%= p.id %>/delete" class="inline" onsubmit="return confirm('Delete package “<%= p.name.replace(/\"/g, '') %>”?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-xs" type="submit">Delete</button>
                </form>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p class="muted">No packages yet — create one above.</p>
      <% } %>
    </div>

    <div class="side-card">
      <h3>Currently sponsored</h3>
      <% if (sponsored.length) { %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Listing</th><th>Until</th><th>Reference</th><th class="ta-right">Actions</th></tr></thead>
          <tbody>
            <% sponsored.forEach(function (l) { %>
            <tr>
              <td><a href="/listing/<%= l.slug %>" target="_blank" style="font-weight:600;color:var(--ink)"><%= l.name %></a></td>
              <td><%= l.sponsored_expires_at || 'lifetime' %></td>
              <td class="muted" style="font-size:12px"><%= l.ad_reference || '—' %></td>
              <td class="ta-right actions-cell">
                <form method="post" action="/admin3119Musa/listings/<%= l.id %>/unsponsor" class="inline" onsubmit="return confirm('Remove sponsorship from “<%= l.name.replace(/\"/g, '') %>”?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-xs" type="submit">Remove</button>
                </form>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p class="muted">No listings are currently sponsored.</p>
      <% } %>
    </div>

    <div class="side-card">
      <div class="section-head" style="align-items:center">
        <div>
          <h3 style="margin-bottom:4px">All listings — sponsor / remove</h3>
          <p class="muted" style="font-size:13px;margin:0">
            <%= totalListings %> listings total — showing <%= listings.length %> (<%= q || status ? 'filtered' : 'latest' %>). Search by company name, category, tagline or owner email.
          </p>
        </div>
        <form method="get" action="/admin3119Musa/advertising" class="ad-search-form" role="search">
          <input type="search" name="q" value="<%= q %>" placeholder="Search listings…" aria-label="Search listings" maxlength="80">
          <select name="status" aria-label="Filter by status">
            <option value="">All statuses</option>
            <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>Approved</option>
            <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>Rejected</option>
          </select>
          <button class="btn btn-primary btn-sm" type="submit">Search</button>
          <% if (q || status) { %><a class="btn btn-ghost btn-sm" href="/admin3119Musa/advertising">Clear</a><% } %>
        </form>
      </div>
      <div class="table-wrap scroll-table">
        <table class="table" id="adListingsTable">
          <thead><tr><th>Listing</th><th>Owner</th><th>Status</th><th>Sponsored</th><th class="ta-right">Actions</th></tr></thead>
          <tbody>
            <% listings.forEach(function (l) { %>
            <tr data-listing-name="<%= l.name.toLowerCase() %>" data-listing-meta="<%= [l.category, l.tagline || '', l.owner_email || ''].join(' ').toLowerCase() %>">
              <td><a href="/admin3119Musa/listings/<%= l.id %>/edit" style="font-weight:600;color:var(--ink)"><%= l.name %></a></td>
              <td class="muted"><%= l.owner_email || '—' %></td>
              <td><span class="pill pill-<%= l.status %>"><%= l.status %></span></td>
              <td>
                <% if (l.sponsored && (l.sponsored_expires_at === '' || l.sponsored_expires_at >= today)) { %>
                <span class="pill pill-featured">Sponsored<% if (l.sponsored_expires_at) { %> · <%= l.sponsored_expires_at %><% } %></span>
                <% } else { %><span class="muted">—</span><% } %>
              </td>
              <td class="ta-right actions-cell">
                <% if (l.sponsored && (l.sponsored_expires_at === '' || l.sponsored_expires_at >= today)) { %>
                <form method="post" action="/admin3119Musa/listings/<%= l.id %>/unsponsor" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-ghost btn-xs" type="submit">Unsponsor</button>
                </form>
                <% } else { %>
                <form method="post" action="/admin3119Musa/listings/<%= l.id %>/sponsor" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="days" value="30">
                  <button class="btn btn-accent btn-xs" type="submit">30d</button>
                </form>
                <form method="post" action="/admin3119Musa/listings/<%= l.id %>/sponsor" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="days" value="90">
                  <button class="btn btn-accent btn-xs" type="submit">90d</button>
                </form>
                <form method="post" action="/admin3119Musa/listings/<%= l.id %>/sponsor" class="inline" title="Lifetime sponsored">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="days" value="lifetime">
                  <button class="btn btn-ghost btn-xs" type="submit">Lifetime</button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (!listings.length) { %>
      <p class="muted" style="margin:12px 0 0">No listings match <%= q ? '“' + q + '”' : '' %><%= q && status ? ' and ' : '' %><%= status ? 'the ' + status + ' filter' : '' %>. Try a different search, or <a href="/admin3119Musa/advertising">clear the filters</a>.</p>
      <% } %>
    </div>
  </div>
</section>

<% if (typeof extraScripts === 'undefined') { %>
<script>
(function () {
  var table = document.getElementById('adListingsTable');
  if (!table) return;
  var form = document.querySelector('.ad-search-form');
  var q = form && form.querySelector('input[name="q"]');
  var statusSel = form && form.querySelector('select[name="status"]');
  function filter() {
    var needle = (q && q.value || '').trim().toLowerCase();
    var st = statusSel ? statusSel.value : '';
    table.querySelectorAll('tbody tr').forEach(function (row) {
      var ok = (!needle || row.dataset.listingName.indexOf(needle) !== -1 || row.dataset.listingMeta.indexOf(needle) !== -1);
      if (ok && st) {
        var pill = row.querySelector('td:nth-child(3) .pill');
        ok = pill && pill.textContent.trim().toLowerCase() === st.toLowerCase();
      }
      row.style.display = ok ? '' : 'none';
    });
  }
  if (q) q.addEventListener('input', filter);
  if (statusSel) statusSel.addEventListener('change', filter);
})();
</script>
<% } %>
<%- include('../partials/bottom') %>
