<%- include('../partials/top') %>

<section class="page-head">
  <div class="container dash-head">
    <div>
      <h1>Dashboard</h1>
      <p class="muted">Welcome back, <%= user.name %> · <%= user.email %></p>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <a href="/dashboard/notifications" class="btn btn-ghost">Notifications<% if (typeof userUnread !== 'undefined' && userUnread) { %> (<%= userUnread %>)<% } %></a>
      <a href="/dashboard/listings/new" class="btn btn-primary">+ Add listing</a>
    </div>
  </div>
</section>

<%
  /* Real, derived numbers — no extra queries beyond what the page already has. */
  const nAppr = listings.filter(l => l.status === 'approved').length;
  const nPend = listings.filter(l => l.status === 'pending').length;
  const nClaimed = listings.filter(l => l.claimed).length;
  const nOpenClaims = claims.filter(c => c.status === 'pending').length;
%>

<section class="section-tight">
  <div class="container">

    <div class="stat-cards" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-bottom:1.6rem">
      <div class="stat-card"><span class="stat-label">Listings</span><span class="stat-num"><%= listings.length %></span><a href="#dash-listings">Manage &rsaquo;</a></div>
      <div class="stat-card"><span class="stat-label">Live</span><span class="stat-num"><%= nAppr %></span><span class="muted" style="font-size:12px"><%= nPend %> awaiting review</span></div>
      <div class="stat-card"><span class="stat-label">Verified</span><span class="stat-num"><%= nClaimed %></span><span class="muted" style="font-size:12px">ownership confirmed</span></div>
      <div class="stat-card"><span class="stat-label">Plan</span><span class="stat-num" style="font-size:1.25rem;padding-top:6px"><%= accountPro ? 'Pro' : 'Free' %></span><a href="/dashboard/upgrade"><%= accountPro ? 'Manage &rsaquo;' : 'Upgrade &rsaquo;' %></a></div>
      <div class="stat-card"><span class="stat-label">Open claims</span><span class="stat-num"><%= nOpenClaims %></span><a href="#dash-claims"><%= nOpenClaims ? 'Resume &rsaquo;' : 'Start &rsaquo;' %></a></div>
      <div class="stat-card"><span class="stat-label">Watchlist</span><span class="stat-num" style="font-size:1.25rem;padding-top:6px"><a href="/dashboard/watchlist" style="margin-top:0">Open &rsaquo;</a></span></div>
    </div>

    <div class="section-head" id="dash-listings"><h2>Your listings</h2><a class="btn btn-ghost btn-sm" href="/dashboard/listings/new">+ Add listing</a></div>
    <% if (listings.length === 0) { %>
      <div class="empty-state">
        <h3>No listings yet</h3>
        <p>Put your first business on the record — it takes about two minutes.</p>
        <a href="/dashboard/listings/new" class="btn btn-primary">Submit a listing</a>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Listing</th><th>Plan</th><th>Status</th><th>Confidence</th><th>FirmLedger Score</th><th class="ta-right">Actions</th></tr></thead>
          <tbody>
            <% listings.forEach(function (l) {
                 const sc = (typeof scores !== 'undefined' && scores[l.id]) || { score: 0, missing: [] };
                 const hasPerks = !!(typeof plans !== 'undefined' && plans[l.id] && plans[l.id].perks);
            %>
              <tr>
                <td>
                  <span class="logo-tile logo-tile-sm"><%= l.name.slice(0, 1) %></span>
                  <strong><%= l.name %></strong>
                  <% if (l.claimed) { %><span class="tick" title="Verified owner">✓</span><% } %>
                  <% if (l.featured) { %><span class="pill pill-featured">Featured</span><% } %>
                  <br><small class="muted"><%= listingLoc(l) %> · <%= typeLabel(l.type) %></small>
                </td>
                <td>
                  <% if (hasPerks) { %>
                    <span class="pill pill-pro" title="Blue tick, homepage Featured slot, premium badge…">PRO perks</span>
                  <% } else { %>
                    <span class="pill pill-free">FREE</span>
                  <% } %>
                  <% if (l.plan === 'pro') { %><div class="score-hint">listing boost<%= l.plan_expires_at ? ' until ' + l.plan_expires_at : ' · lifetime' %></div><% } %>
                </td>
                <td><span class="pill pill-<%= l.status %>"><%= l.status %></span></td>
                <td><span class="conf"><i style="width:<%= l.confidence %>%"></i></span> <span class="conf-num"><%= l.confidence %></span></td>
                <td>
                  <span class="score-chip <%= sc.score >= 75 ? 'hi' : sc.score >= 45 ? 'mid' : 'lo' %>"><%= sc.score %><small>/100</small></span>
                  <% if (sc.missing && sc.missing.length) { %><div class="score-hint"><%= sc.missing[1] %></div><% } %>
                </td>
                <td class="ta-right actions-cell">
                  <% if (l.status === 'approved') { %><a class="btn btn-ghost btn-xs" href="/listing/<%= l.slug %>">View</a><% } %>
                  <a class="btn btn-ghost btn-xs" href="/dashboard/listings/<%= l.id %>/edit">Edit</a>
                  <a class="btn btn-ghost btn-xs" href="/dashboard/listings/<%= l.id %>/jobs">Jobs</a>
                  <% if (!hasPerks) { %>
                    <a class="btn btn-accent btn-xs" href="/dashboard/listings/<%= l.id %>/upgrade">Upgrade</a>
                  <% } %>
                  <% if (l.website) { %>
                    <form method="post" action="/dashboard/listings/<%= l.id %>/refresh-tech" class="inline" title="Re-run technology detection on the homepage">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-ghost btn-xs" type="submit">Refresh tech</button>
                    </form>
                  <% } %>
                  <% if (l.claimed) { %>
                    <a class="btn btn-ghost btn-xs" href="/badge/<%= l.slug %>.svg?theme=light" target="_blank" rel="noopener">Badge</a>
                  <% } else if (l.status === 'approved') { %>
                    <a class="btn btn-ghost btn-xs" href="/claim/<%= l.slug %>">Claim</a>
                  <% } %>
                  <form method="post" action="/dashboard/listings/<%= l.id %>/delete" class="inline" onsubmit="return confirm('Permanently delete this listing? This cannot be undone.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-danger btn-xs" type="submit">Delete</button>
                  </form>
                  <details class="inline dash-removal">
                    <summary class="btn btn-ghost btn-xs">Request removal</summary>
                    <form method="post" action="/dashboard/listings/<%= l.id %>/request-removal" class="form" style="margin-top:8px;min-width:260px">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <label class="fl"><span>Why should this listing come off the ledger?</span>
                        <textarea name="reason" rows="3" required minlength="20" maxlength="2000" placeholder="At least 20 characters…"></textarea>
                      </label>
                      <button class="btn btn-danger btn-xs" type="submit">Send request</button>
                    </form>
                  </details>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (typeof former !== 'undefined' && former && former.length) { %>
      <div class="section-head" style="margin-top:3rem"><h2>Records you submitted</h2></div>
      <div class="side-card" style="max-width:860px">
        <p class="muted" style="margin-bottom:12px">Approved records you submitted that you no longer own. If one of them still carries listing-scoped Pro you paid for, you can ask us to move the remaining time onto a listing you own today.</p>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Listing</th><th>Status</th><th>Plan on that record</th><th class="ta-right">Public page</th></tr></thead>
            <tbody>
              <% former.forEach(function (f) { const hasLp = listingProActive(f); %>
                <tr>
                  <td><span class="logo-tile logo-tile-sm"><%= f.name.slice(0, 1) %></span> <strong><%= f.name %></strong></td>
                  <td><span class="pill pill-<%= f.status %>"><%= f.status %></span><% if (f.claimed) { %> <span class="pill pill-claimed">claimed</span><% } %></td>
                  <td>
                    <% if (hasLp) { %>
                      <span class="pill pill-pro">PRO</span>
                      <div class="score-hint"><%= f.plan_expires_at ? 'until ' + f.plan_expires_at : 'lifetime' %></div>
                    <% } else { %><span class="muted" style="font-size:12.5px">no listing Pro</span><% } %>
                  </td>
                  <td class="ta-right actions-cell">
                    <a class="btn btn-ghost btn-xs" href="/listing/<%= f.slug %>" target="_blank" rel="noopener">View</a>
                    <% if (hasLp && listings.length) { %>
                    <details class="inline dash-removal">
                      <summary class="btn btn-ghost btn-xs">Request Pro transfer</summary>
                      <form method="post" action="/dashboard/pro-transfer" class="form" style="margin-top:8px;min-width:260px">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="from_listing_id" value="<%= f.id %>">
                        <label class="fl"><span>Move remaining Pro onto</span>
                          <select name="to_listing_id" required>
                            <% listings.forEach(function (own) { %><option value="<%= own.id %>"><%= own.name %></option><% }) %>
                          </select>
                        </label>
                        <label class="fl"><span>Note <small>optional</small></span>
                          <input class="input" name="note" maxlength="400" placeholder="I paid for this listing before it was claimed…">
                        </label>
                        <button class="btn btn-accent btn-xs" type="submit">Ask admin</button>
                      </form>
                    </details>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <div class="section-head" style="margin-top:3rem">
      <h2>Claim an existing record</h2>
    </div>
    <div class="side-card" style="max-width:640px">
      <p class="muted">Found your business already listed? Claim it by proving domain control — DNS record, meta tag, or the FirmLedger badge.</p>
      <% if (claimable.length) { %>
      <form id="claimPickerForm" method="get" action="/claim/" role="search" onsubmit="event.preventDefault(); var s=document.getElementById('claimSlug'); if(s && s.value) location.href='/claim/'+encodeURIComponent(s.value);" style="margin-top:12px">
        <input type="hidden" id="claimSlug" name="slug" value="">
        <label style="margin:0;display:block"><span class="fld-cap">Search unclaimed listings</span>
          <div class="suggest-box search-suggest">
            <div class="search-hero">
              <input class="input search-hero-in" type="search" id="claimQ" placeholder="Company, category or city…" autocomplete="off" maxlength="80" aria-label="Search unclaimed listings">
              <button class="btn btn-gold" type="submit" id="claimGo" disabled>Start claim</button>
            </div>
            <ul class="suggest-list" id="claimResults" hidden></ul>
          </div>
        </label>
        <p class="fine-print" id="claimPicked" style="margin-top:0">Start typing to find a record, then Start claim.</p>
      </form>
      <script>
      (function () {
        var q = document.getElementById('claimQ');
        var list = document.getElementById('claimResults');
        var slug = document.getElementById('claimSlug');
        var go = document.getElementById('claimGo');
        var picked = document.getElementById('claimPicked');
        if (!q || !list) return;
        var t = null, rows = [], sel = -1;
        function pick(i) {
          var r = rows[i];
          if (!r) return;
          sel = i; paint();
          slug.value = r.slug;
          q.value = r.name;
          go.disabled = false;
          picked.textContent = 'Selected: ' + r.name + ' — Start claim to prove domain control.';
          list.hidden = true;
        }
        function paint() {
          list.innerHTML = '';
          if (!rows || !rows.length) { list.hidden = true; return; }
          rows.forEach(function (r, i) {
            var li = document.createElement('li');
            li.innerHTML = '<span>' + String(r.name || '').replace(/</g,'') + '</span><span class="suggest-cat">' +
              [r.category, r.city, r.country].filter(Boolean).join(' · ').replace(/</g,'') + '</span>';
            if (i === sel) li.setAttribute('data-sel', '1');
            li.addEventListener('mousedown', function (e) { e.preventDefault(); pick(i); });
            list.appendChild(li);
          });
          list.hidden = false;
        }
        function fetchRows() {
          var v = q.value.trim();
          fetch('/dashboard/claimable.json?q=' + encodeURIComponent(v), { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (d) { rows = d.listings || []; sel = -1; paint(); })
            .catch(function () { list.hidden = true; });
        }
        q.addEventListener('input', function () {
          slug.value = '';
          go.disabled = true;
          clearTimeout(t);
          t = setTimeout(fetchRows, 180);
        });
        q.addEventListener('focus', function () { if (!slug.value) fetchRows(); });
        q.addEventListener('blur', function () { setTimeout(function () { list.hidden = true; sel = -1; }, 180); });
        q.addEventListener('keydown', function (e) {
          if (list.hidden || !rows.length) return;
          if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(rows.length - 1, sel + 1); paint(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(0, sel - 1); paint(); }
          else if (e.key === 'Enter' && sel >= 0) { e.preventDefault(); pick(sel); }
          else if (e.key === 'Escape') { list.hidden = true; sel = -1; }
        });
      })();
      </script>
      <% } else { %>
      <p class="muted" style="font-size:13px;margin-top:8px">Every approved listing on FirmLedger is already claimed — nothing to claim right now.</p>
      <a class="btn btn-ghost btn-sm" href="/dashboard/listings/new" style="margin-top:8px">Submit a new listing</a>
      <% } %>
    </div>

    <div class="section-head" style="margin-top:3rem"><h2>Your subscription</h2></div>
    <div class="side-card" style="max-width:640px">
      <div class="upgrade-status">
        <div class="us-title">
          <b><% if (accountPro) { %>FirmLedger Pro<span class="pill pill-pro" style="margin-left:8px">ACTIVE</span><% } else { %>Free plan<span class="pill pill-free" style="margin-left:8px">CURRENT</span><% } %></b>
          <span class="muted" style="font-size:13px">
            <% if (accountPro && accountExpires) { %>Active until <b><%= accountExpires %></b> · paying again extends it.<% } %>
            <% if (accountPro && !accountExpires) { %>Lifetime — admin-granted.<% } %>
            <% if (!accountPro) { %>Upgrade to unlock every listing's full details — and give your own listings the blue tick, homepage Featured slot and premium badge.<% } %>
          </span>
        </div>
      </div>
      <% if (!accountPro && !paypalReady) { %>
        <p class="fine-print" style="color:var(--warn)">Online payments are not configured on this deployment yet — the team can still grant Pro manually from the admin console.</p>
      <% } %>
      <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">
        <a class="btn <%= accountPro ? 'btn-ghost' : 'btn-accent' %>" href="/dashboard/upgrade"><%= accountPro ? 'Manage / extend your plan' : 'Upgrade to Pro' %></a>
        <a class="btn btn-ghost" href="/pricing" target="_blank" rel="noopener">Pricing</a>
      </div>
    </div>

    <div class="section-head" style="margin-top:3rem"><h2>Account settings</h2></div>
    <div class="acct-grid">
      <div class="side-card">
        <h3 style="margin:0 0 10px">Profile</h3>
        <p class="muted" style="margin-bottom:14px">Your name and sign-in email, used across submissions and claims.</p>
        <form method="post" action="/dashboard/account" class="form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="fl"><span>Name</span><input class="input" name="name" value="<%= user.name %>" required maxlength="80"></label>
          <label class="fl"><span>Email</span><input class="input" type="email" name="email" value="<%= user.email %>" required maxlength="190"></label>
          <% if (fa2On) { %>
            <label class="fl"><span>Authenticator / recovery code</span><input class="input" name="fa_code" placeholder="6 digits or xxxx-xxxx-xxxx" autocomplete="off" required style="font-variant-numeric:tabular-nums"></label>
            <p class="muted" style="font-size:.78rem;margin:-6px 0 10px">Your account has 2FA — this change needs your current app code or an unused recovery code.</p>
          <% } %>
          <button class="btn btn-primary btn-sm" type="submit">Save changes</button>
        </form>
      </div>
      <div class="side-card">
        <h3 style="margin:0 0 10px">Password</h3>
        <p class="muted" style="margin-bottom:14px">Changing your password signs out all other devices.</p>
        <form method="post" action="/dashboard/password" class="form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="fl"><span>Current password</span><input class="input" type="password" name="current_password" required autocomplete="current-password"></label>
          <label class="fl"><span>New password</span>
            <div class="pw-wrap"><input class="input" type="password" name="new_password" id="dash-pw" required minlength="8" placeholder="At least 8 characters" autocomplete="new-password" data-pw-input="dash-pw-meter" data-eye-for="dash-pw"></div>
            <div class="pw-meter" id="dash-pw-meter" style="display:none"></div>
          </label>
          <label class="fl"><span>Confirm new password</span>
            <div class="pw-wrap"><input class="input" type="password" name="new_password_confirm" id="dash-pw2" required minlength="8" placeholder="Retype the new password" autocomplete="new-password" data-pw-confirm="dash-pw" data-pw-note="dash-pw-match" data-eye-for="dash-pw2"></div>
            <div class="pw-match" id="dash-pw-match"></div>
          </label>
          <% if (fa2On) { %>
            <label class="fl"><span>Authenticator / recovery code</span><input class="input" name="fa_code" placeholder="6 digits or xxxx-xxxx-xxxx" autocomplete="off" required style="font-variant-numeric:tabular-nums"></label>
            <p class="muted" style="font-size:.78rem;margin:-6px 0 10px">Your account has 2FA — this change needs your current app code or an unused recovery code.</p>
          <% } %>
          <button class="btn btn-primary btn-sm" type="submit">Change password</button>
        </form>
      </div>
      <div class="side-card">
        <h3 style="margin:0 0 10px">Security</h3>
        <p class="muted" style="margin-bottom:14px">Two-factor authentication protects password &amp; email changes.</p>
        <% if (fa2On) { %>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
            <span class="badge badge-ok">2FA enabled</span>
            <span class="muted" style="font-size:.82rem">Password &amp; email changes require a code from your authenticator app.</span>
          </div>
        <% } else { %>
          <p class="muted" style="font-size:.85rem;margin-bottom:12px">2FA is off. Turn it on to require a code for password &amp; email changes.</p>
        <% } %>
        <a class="btn btn-ghost btn-sm" href="/dashboard/security"><%= fa2On ? 'Manage 2FA' : 'Enable 2FA' %></a>
      </div>
      <div class="side-card">
        <h3 style="margin:0 0 10px">Support</h3>
        <p class="muted" style="margin-bottom:14px">Billing, listings, technical issues — chat live with the team and attach files.</p>
        <a class="btn btn-primary btn-sm" href="/dashboard/support">Open support</a>
      </div>
      <div class="side-card">
        <h3 style="margin:0 0 10px">Delete my account</h3>
        <p class="muted" style="margin-bottom:14px">Ask the team to permanently remove your account. Listings you submitted stay on the ledger as factual records.</p>
        <% if (typeof pendingDeletion !== 'undefined' && pendingDeletion) { %>
          <p class="muted" style="font-size:.82rem;margin-bottom:10px">A request is already waiting (<%= fmtDate(pendingDeletion.created_at) %>).</p>
        <% } %>
        <a class="btn btn-danger btn-sm" href="/dashboard/delete-account"><%= pendingDeletion ? 'View deletion request' : 'Request deletion' %></a>
      </div>
      <div class="side-card">
        <h3 style="margin:0 0 10px">Watchlist</h3>
        <p class="muted" style="margin-bottom:14px">Star companies to track them — email digests when their record changes<% if (accountPro) { %>, plus CSV export for your CRM<% } %>.</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <a class="btn btn-ghost btn-sm" href="/dashboard/watchlist">Open watchlist</a>
          <a class="btn btn-ghost btn-sm" href="/jobs">Jobs board</a>
        </div>
      </div>
      <div class="side-card">
        <h3 style="margin:0 0 10px">Developer API <% if (accountPro) { %><span class="pill pill-pro" style="margin-left:6px">PRO</span><% } %></h3>
        <p class="muted" style="margin-bottom:14px">REST access to your records — API-key auth, CRUD endpoints, rate limits, docs &amp; a live playground.<% if (!accountPro) { %> <b>Included with Pro.</b><% } %></p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <a class="btn btn-ghost btn-sm" href="/dashboard/api">API keys &amp; usage</a>
          <a class="btn btn-ghost btn-sm" href="/dashboard/api/playground">Playground</a>
        </div>
      </div>
      <div class="side-card">
        <h3 style="margin:0 0 10px">Digest &amp; notifications</h3>
        <p class="muted" style="margin-bottom:14px">Email cadence for your watchlist and in-app inbox — everything is opt-out.</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <a class="btn btn-ghost btn-sm" href="/dashboard/settings">Digest settings</a>
          <a class="btn btn-ghost btn-sm" href="/dashboard/notifications">Inbox<% if (typeof userUnread !== 'undefined' && userUnread) { %> · <%= userUnread %> new<% } %></a>
        </div>
      </div>
    </div>

    <% if (claims.length) { %>
      <div class="section-head" style="margin-top:3rem" id="dash-claims"><h2>Your verification requests</h2></div>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Listing</th><th>Method</th><th>Domain</th><th>Status</th><th>Requested</th><th></th></tr></thead>
          <tbody>
            <% claims.forEach(function (c) { %>
              <tr>
                <td><a href="/listing/<%= c.listing_slug %>"><strong><%= c.listing_name %></strong></a></td>
                <td><% if (c.method === 'dns') { %>DNS record<% } else if (c.method === 'meta') { %>Meta tag<% } else { %>Site badge<% } %></td>
                <td><code><%= c.domain %></code></td>
                <td><span class="pill pill-<%= c.status === 'verified' ? 'approved' : c.status === 'pending' ? 'pending' : 'rejected' %>"><%= c.status %></span></td>
                <td class="muted"><%= fmtDate(c.created_at) %></td>
                <td class="ta-right"><% if (c.status === 'pending') { %><a class="btn btn-ghost btn-xs" href="/claim/verify/<%= c.id %>">Resume verification</a><% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/bottom') %>
