<%- include('../partials/top') %>

<section class="page-head">
  <div class="container dash-head">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/dashboard">Dashboard</a><span aria-hidden="true">›</span><span>Notification settings</span></nav>
      <h1>Notification settings</h1>
      <p class="muted">Choose what lands in your inbox. Security emails are always on; these are the ones you control.</p>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <% if (ok) { %><div class="alert alert-ok" style="margin-bottom:1rem"><%= ok %></div><% } %>
    <% if (err) { %><div class="alert alert-err" style="margin-bottom:1rem"><%= err %></div><% } %>

    <div class="settings-grid">
      <div class="form-card">
        <h3 class="form-section">Email preferences</h3>

        <div class="pref-row">
          <div class="pref-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          </div>
          <div class="pref-copy">
            <div class="pref-title">
              Weekly digest — new verified companies
              <span class="pill <%= active ? 'pill-approved' : 'pill-pending' %>" style="margin-left:8px"><%= active ? 'On' : 'Off' %></span>
            </div>
            <p class="pref-desc">
              One short email per week: freshly verified businesses and the newest additions to the ledger.
              Sent to <b><%= user.email %></b>. One-click unsubscribe, anytime.
              <% if (sub && active) { %>Subscribed <%= fmtDate(sub.created_at) %> (source: <%= sub.source %>).<% } %>
            </p>
          </div>
          <form method="post" action="/dashboard/settings/digest" style="margin:0;flex-shrink:0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="digest" value="<%= active ? '0' : '1' %>">
            <button class="btn <%= active ? 'btn-ghost' : 'btn-primary' %> btn-sm" type="submit"><%= active ? 'Turn off' : 'Turn on' %></button>
          </form>
        </div>

        <div class="pref-row" style="border-top:1px solid var(--hair)">
          <div class="pref-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>
          </div>
          <div class="pref-copy">
            <div class="pref-title">
              Weekly leads report
              <span class="pill <%= leadsDigest === 'none' ? 'pill-pending' : 'pill-approved' %>" style="margin-left:8px"><%= leadsDigest === 'both' ? 'Email + notifications' : leadsDigest === 'email' ? 'Email only' : leadsDigest === 'notification' ? 'Notifications only' : 'Off' %></span>
            </div>
            <p class="pref-desc">
              One automatic report per week — how many leads your listings generated, how many qualified and won —
              sent only in weeks with activity.
              <% if (!ownsListings) { %>You don't own any listings yet, so there's nothing to report; the choice below applies from your first listing.<% } %>
            </p>
            <form method="post" action="/dashboard/settings/leads-digest" class="pref-chan">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label><input type="radio" name="leads_digest" value="both"<%= leadsDigest === 'both' ? ' checked' : '' %>> <span>Email + in-app <em>recommended</em></span></label>
              <label><input type="radio" name="leads_digest" value="email"<%= leadsDigest === 'email' ? ' checked' : '' %>> <span>Email only</span></label>
              <label><input type="radio" name="leads_digest" value="notification"<%= leadsDigest === 'notification' ? ' checked' : '' %>> <span>In-app only</span></label>
              <label><input type="radio" name="leads_digest" value="none"<%= leadsDigest === 'none' ? ' checked' : '' %>> <span>Off</span></label>
              <button class="btn btn-ghost btn-sm" type="submit">Save</button>
            </form>
          </div>
        </div>

        <div class="pref-row" style="border-top:1px solid var(--hair)">
          <div class="pref-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div class="pref-copy">
            <div class="pref-title">
              Leads conversation replies
              <span class="pill pill-approved" style="margin-left:8px">Email first, then notifications</span>
            </div>
            <p class="pref-desc">
              When someone answers a Leads conversation, only the first message to you is emailed —
              every reply after that arrives as a site notification in <a href="/dashboard/notifications">Notifications</a>,
              so a long thread never floods your inbox. You can keep the whole conversation in
              <a href="/dashboard/leads">Dashboard → Leads</a>, or delete a conversation permanently from there.
            </p>
          </div>
        </div>

        <div class="pref-row" style="border-top:1px solid var(--hair)">
          <div class="pref-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.9 6.26 6.6.56-5 4.4 1.5 6.44L12 16.9l-6 2.76 1.5-6.44-5-4.4 6.6-.56L12 2z"/></svg>
          </div>
          <div class="pref-copy">
            <div class="pref-title">Watchlist update alerts</div>
            <p class="pref-desc">
              Instant digest when a company on your <a href="/dashboard/watchlist">watchlist</a> changes its record — new tech, location, team size.
              Add companies to the watchlist and these arrive automatically.
            </p>
          </div>
          <a class="btn btn-ghost btn-sm" href="/dashboard/watchlist" style="flex-shrink:0">Manage watchlist</a>
        </div>

        <div class="pref-row" style="border-top:1px solid var(--hair);opacity:.72">
          <div class="pref-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <div class="pref-copy">
            <div class="pref-title">Security &amp; account notices <span class="pill pill-approved" style="margin-left:8px">Always on</span></div>
            <p class="pref-desc">Password changes, sign-in alerts and moderation decisions are always emailed — they protect your account and can't be switched off.</p>
          </div>
        </div>
      </div>

      <div class="form-card">
        <h3 class="form-section">More settings</h3>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-ghost btn-sm" href="/dashboard">Account profile</a>
          <a class="btn btn-ghost btn-sm" href="/dashboard/security">Two-factor authentication</a>
          <a class="btn btn-ghost btn-sm" href="/dashboard/upgrade">Plan &amp; upgrades</a>
          <a class="btn btn-ghost btn-sm" href="/dashboard/support">Support</a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
