<%- include('../partials/top') %>

<section class="section-tight">
  <div class="container" style="max-width:980px">
    <div class="breadcrumbs"><a href="/dashboard">Dashboard</a><span aria-hidden="true">›</span><span>Support</span></div>

    <div class="section-head" style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem">
      <div>
        <h2>Support tickets</h2>
        <p class="muted" style="font-size:14px">Open a ticket and chat live with the team.</p>
      </div>
      <a class="btn btn-primary" href="/dashboard/support/new" style="flex:0 0 auto">+ New ticket</a>
    </div>

    <% if (flashMsg) { %><div class="alert alert-ok" style="margin-bottom:1.5rem"><%= flashMsg %></div><% } %>

    <% if (!tickets.length) { %>
      <div class="card">
        <div class="card-body" style="text-align:center;padding:3rem 1.5rem">
          <div style="color:var(--accent);margin-bottom:.8rem"><svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg></div>
          <h2 style="margin:0 0 .6rem;font-size:1.25rem">No tickets yet</h2>
          <p class="muted" style="max-width:42ch;margin:0 auto 1.2rem">Have a billing question, trouble claiming a listing, or a tech issue? Open a ticket and the team replies in the live chat.</p>
          <a class="btn btn-primary" href="/dashboard/support/new">Open your first ticket</a>
        </div>
      </div>
    <% } else { %>
      <div class="ticket-list">
        <% tickets.forEach(function (t) { %>
          <a class="ticket-card" href="/dashboard/support/<%= t.id %>">
            <div class="ticket-head">
              <span class="ticket-ref"><%= t.ref %></span>
              <span class="badge badge-cat"><%= t.category %></span>
              <span class="badge status-<%= t.status %>"><%= t.status === 'open' ? 'Open' : t.status === 'solved' ? 'Solved' : 'Closed' %></span>
            </div>
            <div class="ticket-subject"><%= t.subject %></div>
            <div class="ticket-meta">
              Updated <%= fmtDate(new Date(t.updated_at.replace(' ','T') + 'Z')) %> · opened <%= fmtDate(new Date(t.created_at.replace(' ','T') + 'Z')) %>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/bottom') %>
