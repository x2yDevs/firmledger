<%- include('../partials/top') %>

<section class="section-tight">
  <div class="container">
    <div class="breadcrumbs"><a href="/dashboard">Dashboard</a><span aria-hidden="true">›</span><span>Watchlist</span></div>

    <div class="section-head" style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem">
      <div>
        <h2>Your watchlist</h2>
        <p class="muted" style="margin:4px 0 0;font-size:14px">Companies you star land here. When a watched record changes — new tech, location, team size — you get an email digest.</p>
      </div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <% if (accountPro) { %>
          <a class="btn btn-primary" href="/dashboard/watchlist.csv"><svg class="ric" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Export CSV</a>
        <% } else { %>
          <a class="btn btn-ghost" href="/pricing" style="border-style:dashed"><svg class="ric" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Export CSV — Pro</a>
        <% } %>
      </div>
    </div>

    <% if (ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
    <% if (err) { %><div class="alert alert-err"><%= err %></div><% } %>

    <% if (!rows.length) { %>
      <div class="panel" style="text-align:center;padding:56px 24px">
        <h3 style="font-family:var(--fd);font-size:22px;margin-bottom:8px">Nothing starred yet</h3>
        <p class="muted" style="max-width:460px;margin:0 auto">Open any company in the directory and press the star-shaped <b>Watch</b> button — it lands on this list with live update alerts. Great for tracking clients, competitors or employers.</p>
        <a class="btn btn-primary" style="margin-top:18px" href="/directory">Browse the directory</a>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Company</th><th>Category</th><th>Location</th><th>Website</th><th>Confidence</th><th>Watched since</th><th style="text-align:right">Actions</th></tr>
          </thead>
          <tbody>
            <% rows.forEach(function (r) { %>
              <tr>
                <td>
                  <div style="display:flex;align-items:center;gap:10px">
                    <% if (r.logo_url) { %><img src="<%= r.logo_url %>" alt="" width="32" height="32" style="border-radius:8px;border:1px solid var(--hair);object-fit:cover"><% } %>
                    <div>
                      <a href="/listing/<%= r.slug %>" style="font-weight:600;color:var(--ink)"><%= r.name %></a>
                      <% if (r.claimed) { %><span class="job-vtick" title="Verified owner" style="margin-left:6px"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span><% } %>
                      <% if (r.status !== 'approved') { %><span class="badge status-<%= r.status %>" style="margin-left:6px"><%= r.status %></span><% } %>
                    </div>
                  </div>
                </td>
                <td class="muted"><%= r.category %></td>
                <td class="muted"><%= [r.city, r.country].filter(Boolean).join(', ') || '—' %></td>
                <td><% if (r.website) { %><a href="https://<%= r.website.replace(/^https?:\/\//,'') %>" target="_blank" rel="noopener nofollow"><%= r.website.replace(/^https?:\/\//,'').replace(/\/$/,'') %></a><% } else { %>—<% } %></td>
                <td><%- dial(r.confidence) %></td>
                <td class="muted" style="font-size:.82rem"><%= fmtDate(r.watched_at) %></td>
                <td style="text-align:right;white-space:nowrap">
                  <form method="post" action="/dashboard/watchlist/toggle" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="listing_id" value="<%= r.id %>">
                    <input type="hidden" name="back" value="/dashboard/watchlist">
                    <button class="btn btn-ghost btn-sm" type="submit" title="Remove from watchlist"><svg class="ric" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M12 2l2.9 6.26 6.6.56-5 4.4 1.5 6.44L12 16.9l-6 2.76 1.5-6.44-5-4.4 6.6-.56L12 2z"/></svg>Remove</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="wl-export-note"><%= rows.length %> compan<%= rows.length === 1 ? 'y' : 'ies' %> watched<% if (accountPro) { %> · the CSV export includes names, emails, websites and tech stacks for your CRM<% } %>.</p>
    <% } %>
  </div>
</section>

<%- include('../partials/bottom') %>
