<%- include('../partials/top') %>

<%
  /* Keep the current filters on every link inside the inbox. */
  const _fq = [];
  if (filters.status) _fq.push('status=' + encodeURIComponent(filters.status));
  if (filters.listingId) _fq.push('listing=' + encodeURIComponent(filters.listingId));
  if (filters.archived) _fq.push('box=archived');
  const _fqs = _fq.length ? _fq.join('&') + '&' : '';
%>
<section class="page-head">
  <div class="container dash-head">
    <div>
      <p class="crumb"><a href="/dashboard">Dashboard</a> → Leads</p>
      <h1>Leads inbox</h1>
      <p class="muted">Inquiries from the “Contact this business” button on your claimed listings — your email address is never shown to inquirers.</p>
    </div>
    <% if (pro) { %>
    <form class="ana-pick" method="get" action="/dashboard/leads">
      <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
      <% if (filters.archived) { %><input type="hidden" name="box" value="archived"><% } %>
      <label><span class="muted" style="font-size:12.5px">Listing</span>
        <select name="listing" onchange="this.form.submit()">
          <option value="">All listings</option>
          <% listings.forEach(function (gl) { %><option value="<%= gl.id %>"<%= Number(filters.listingId) === gl.id ? ' selected' : '' %>><%= gl.name %></option><% }) %>
        </select>
      </label>
    </form>
    <% } %>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <% if (typeof ok !== 'undefined' && ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
    <% if (typeof err !== 'undefined' && err) { %><div class="alert alert-err"><%= err %></div><% } %>

    <% if (!pro) { %>
      <div class="panel pro-locked" style="max-width:720px">
        <div class="plc-left">
          <span class="plc-lock" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
          <div>
            <h3 style="margin:0">Leads inbox ✦ FirmLedger Pro</h3>
            <p style="font-size:13.5px;color:var(--muted);margin:.35rem 0 0">
              <% if (counts.total) { %>
                You have <b><%= counts.total %> waiting <%= counts.total === 1 ? 'inquiry' : 'inquiries' %></b><%= counts.new ? ` — ${counts.new} new` : '' %>. Inquiries keep arriving while you're on Free; reading and managing them unlocks with Pro.
              <% } else { %>
                Every claimed listing carries a “Contact this business” button, and inquiries land here with statuses, notes and archiving. Nothing waiting yet — claim a listing and share it.
              <% } %>
            </p>
          </div>
        </div>
        <div class="plc-actions">
          <a class="btn btn-accent btn-sm" href="/dashboard/upgrade">Upgrade to Pro</a>
          <a class="btn btn-ghost btn-sm" href="/pricing">See pricing</a>
        </div>
      </div>
    <% } else { %>
      <div class="lead-tabs" role="tablist" aria-label="Lead filters">
        <a role="tab" aria-selected="<%= !filters.status && !filters.archived %>" class="lead-tab<%= !filters.status && !filters.archived ? ' on' : '' %>" href="/dashboard/leads<%= filters.listingId ? '?listing=' + filters.listingId : '' %>">All <span class="lead-n"><%= counts.total %></span></a>
        <% STATUSES.forEach(function (s) { %>
        <a role="tab" aria-selected="<%= filters.status === s && !filters.archived %>" class="lead-tab<%= filters.status === s && !filters.archived ? ' on' : '' %>" href="/dashboard/leads?status=<%= s %><%= filters.listingId ? '&listing=' + filters.listingId : '' %>"><%= STATUS_LABELS[s] %> <span class="lead-n"><%= counts[s] || 0 %></span></a>
        <% }) %>
        <a role="tab" aria-selected="<%= filters.archived %>" class="lead-tab<%= filters.archived ? ' on' : '' %>" href="/dashboard/leads?box=archived<%= filters.listingId ? '&listing=' + filters.listingId : '' %>">Archived <span class="lead-n"><%= counts.archived %></span></a>
      </div>

      <div class="lead-layout">
        <div class="lead-list-col">
          <% if (!box.rows.length) { %>
            <div class="empty-state">
              <h3><%= filters.archived ? 'Nothing archived' : filters.status ? 'No ' + STATUS_LABELS[filters.status].toLowerCase() + ' leads' : 'No inquiries yet' %></h3>
              <p><%= filters.archived || filters.status ? 'Try another filter — or clear it to see everything.' : 'When a visitor contacts one of your claimed listings, the inquiry appears here and in your email.' %></p>
              <% if (filters.archived || filters.status) { %><a class="btn btn-ghost btn-sm" href="/dashboard/leads">Clear filters</a><% } %>
            </div>
          <% } else { %>
            <div class="lead-list">
              <% box.rows.forEach(function (ld) { %>
              <a class="lead-row<%= open && open.id === ld.id ? ' open' : '' %><%= ld.status === 'new' ? ' is-new' : '' %>" href="/dashboard/leads?<%= _fqs %>open=<%= ld.id %>">
                <span class="lead-row-main">
                  <b><%= ld.name %></b>
                  <small class="muted"><%= ld.looking_for || ld.message.slice(0, 80) %></small>
                  <small class="muted"><%= ld.listing_name %> · <%= fmtDate(ld.created_at) %></small>
                </span>
                <span class="pill pill-lead-<%= ld.status %>"><%= STATUS_LABELS[ld.status] %></span>
              </a>
              <% }) %>
            </div>
            <% if (box.pages > 1) { %>
            <nav class="pagination" aria-label="Leads pages">
              <% if (box.page > 1) { %><a class="btn btn-ghost btn-sm" href="/dashboard/leads?<%= _fqs %>page=<%= box.page - 1 %>">← Newer</a><% } %>
              <span class="results-line" style="margin:0">Page <%= box.page %> of <%= box.pages %></span>
              <% if (box.page < box.pages) { %><a class="btn btn-ghost btn-sm" href="/dashboard/leads?<%= _fqs %>page=<%= box.page + 1 %>">Older →</a><% } %>
            </nav>
            <% } %>
          <% } %>
        </div>

        <div class="lead-detail-col">
          <% if (open) { %>
          <div class="panel lead-detail">
            <div class="panel-h-t">
              <h3><%= open.name %></h3>
              <a class="muted" style="font-size:.8rem" href="/dashboard/leads?<%= _fqs.replace(/&$/, '') %>">Close ✕</a>
            </div>
            <p class="muted" style="font-size:13px;margin-top:-4px">For <a href="/listing/<%= open.listing_slug %>"><%= open.listing_name %></a> · <%= fmtDate(open.created_at) %><% if (open.city || open.country) { %> · <%= [open.city, open.country].filter(Boolean).join(', ') %><% } %></p>
            <table class="facts">
              <tr><th>Email</th><td><a href="mailto:<%= open.email %>" style="color:var(--accent2)"><%= open.email %></a></td></tr>
              <% if (open.phone) { %><tr><th>Phone</th><td><a href="tel:<%= String(open.phone).replace(/\s/g, '') %>" style="color:var(--accent2)"><%= open.phone %></a></td></tr><% } %>
              <% if (open.looking_for) { %><tr><th>Looking for</th><td><%= open.looking_for %></td></tr><% } %>
            </table>
            <div class="lead-msg"><%- String(open.message).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\n/g, '<br>') %></div>
            <div class="lead-actions">
              <a class="btn btn-primary btn-sm" href="mailto:<%= open.email %>?subject=<%= encodeURIComponent('Re: your inquiry to ' + open.listing_name + (open.looking_for ? ' — ' + open.looking_for : '')) %>">Reply by email</a>
              <% if (open.phone) { %><a class="btn btn-ghost btn-sm" href="tel:<%= String(open.phone).replace(/\s/g, '') %>">Call</a><% } %>
            </div>
            <form class="lead-status-form" method="post" action="/dashboard/leads/<%= open.id %>/status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label><span>Status</span>
                <select name="status">
                  <% STATUSES.forEach(function (s) { %><option value="<%= s %>"<%= open.status === s ? ' selected' : '' %>><%= STATUS_LABELS[s] %></option><% }) %>
                </select>
              </label>
              <button class="btn btn-ghost btn-sm" type="submit">Update</button>
            </form>
            <form method="post" action="/dashboard/leads/<%= open.id %>/archive" style="margin-top:10px">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="archived" value="<%= open.archived ? '0' : '1' %>">
              <button class="btn btn-ghost btn-sm" type="submit"><%= open.archived ? 'Restore to inbox' : 'Archive' %></button>
            </form>
            <h4 class="h-section" style="margin-top:1.6rem">Notes <span class="muted" style="font-weight:400">· only you see these</span></h4>
            <% if (openNotes.length) { %>
            <ul class="lead-notes">
              <% openNotes.forEach(function (n) { %>
              <li><p><%= n.note %></p><small class="muted"><%= fmtDate(n.created_at) %></small></li>
              <% }) %>
            </ul>
            <% } else { %>
            <p class="muted" style="font-size:13px">No notes yet — record calls, quotes and follow-ups here.</p>
            <% } %>
            <form class="lead-note-form" method="post" action="/dashboard/leads/<%= open.id %>/note">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label><span class="sr-only">Add a note</span><textarea class="input" name="note" rows="2" maxlength="2000" placeholder="Add a private note…"></textarea></label>
              <button class="btn btn-ghost btn-sm" type="submit">Add note</button>
            </form>
          </div>
          <% } else if (box.rows.length) { %>
          <div class="panel lead-detail lead-detail-empty">
            <p class="muted">Select an inquiry to read it, reply, set its status and add notes.</p>
          </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/bottom') %>
