<%- include('../partials/top') %>

<%
  /* ── Inbox URLs ──────────────────────────────────────────────────────────
     Every link and every form carries the current view with it: which box,
     which status filter, which listing, which page. Acting inside a thread —
     replying, setting a status, archiving — returns you to the same list with
     the same pills and counts instead of dropping you on page one of
     “Received” while you were working through “Won”. */
  const _fq = [];
  if (filters.box === 'sent') _fq.push('box=sent');
  else {
    if (filters.status) _fq.push('status=' + encodeURIComponent(filters.status));
    if (filters.listingId) _fq.push('listing=' + encodeURIComponent(filters.listingId));
    if (filters.archived) _fq.push('box=archived');
  }
  const _page = Number(box.page) > 1 ? ['page=' + Number(box.page)] : [];
  const leadUrl = function (extra) {
    const parts = _fq.concat(_page, extra || []);
    return '/dashboard/leads' + (parts.length ? '?' + parts.join('&') : '');
  };
  /* Pagination sets its own page, so it takes the filters only. */
  const pageUrl = function (n) {
    return '/dashboard/leads?' + _fq.concat('page=' + n).join('&');
  };
  const _attr = function (v) {
    return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  };
  /* Read back by the POST routes so a redirect lands on this exact view. */
  const ctxFields = function () {
    return '<input type="hidden" name="ctx_box" value="' + _attr(filters.box) + '">'
      + '<input type="hidden" name="ctx_status" value="' + _attr(STATUSES.indexOf(filters.status) > -1 ? filters.status : '') + '">'
      + '<input type="hidden" name="ctx_listing" value="' + _attr(filters.listingId || '') + '">'
      + '<input type="hidden" name="ctx_page" value="' + _attr(Number(box.page) || 1) + '">';
  };
  const isSent = filters.box === 'sent';
  const isArchived = filters.archived;
  /* The composer's rules are the server's rules — same numbers, one source. */
  const rMin = Number(REPLY_MIN) || 2;
  const rMax = Number(REPLY_MAX) || 4000;
  const nf = function (n) { return Number(n).toLocaleString('en-US'); };
%>
<% /* The inbox is a screen-filling shell: the head above it stays slim so the
      conversation — not the title block — owns the viewport. Scoped to
      .leads-head/.leads-section; every other page keeps its own head. */ %>
<section class="page-head leads-head">
  <div class="container dash-head">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/dashboard">Dashboard</a><span aria-hidden="true">›</span><span>Leads</span></nav>
      <h1>Leads inbox</h1>
      <p class="muted">Talk with verified businesses you contacted — and manage inquiries on listings you own. Your FirmLedger email is used automatically; the business email stays private.</p>
    </div>
    <% if (pro && !isSent) { %>
    <form class="ana-pick fl-select" method="get" action="/dashboard/leads">
      <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
      <% if (filters.archived) { %><input type="hidden" name="box" value="archived"><% } %>
      <label><span class="muted" style="font-size:12.5px">Listing</span>
        <select class="input" name="listing" onchange="this.form.submit()">
          <option value="">All listings</option>
          <% listings.forEach(function (gl) { %><option value="<%= gl.id %>"<%= Number(filters.listingId) === gl.id ? ' selected' : '' %>><%= gl.name %></option><% }) %>
        </select>
      </label>
    </form>
    <% } %>
  </div>
</section>

<section class="section-tight leads-section">
  <div class="container">
    <% if (typeof ok !== 'undefined' && ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
    <% if (typeof err !== 'undefined' && err) { %><div class="alert alert-err"><%= err %></div><% } %>

    <div class="lead-tabs" role="tablist" aria-label="Lead boxes">
      <a role="tab" aria-selected="<%= !isSent && !isArchived && !filters.status %>" class="lead-tab<%= !isSent && !isArchived && !filters.status ? ' on' : '' %>" href="/dashboard/leads<%= filters.listingId ? '?listing=' + encodeURIComponent(filters.listingId) : '' %>">Received <span class="lead-n"><%= counts.total %></span></a>
      <a role="tab" aria-selected="<%= isSent %>" class="lead-tab<%= isSent ? ' on' : '' %>" href="/dashboard/leads?box=sent">Sent <span class="lead-n"><%= sentCounts.total %></span><% if (sentCounts.waiting) { %> <span class="lead-wait"><%= sentCounts.waiting %> new <%= sentCounts.waiting === 1 ? 'reply' : 'replies' %></span><% } %></a>
      <% if (pro && !isSent) { %>
        <% STATUSES.forEach(function (s) { %>
        <a role="tab" aria-selected="<%= filters.status === s && !isArchived %>" class="lead-tab<%= filters.status === s && !isArchived ? ' on' : '' %>" href="/dashboard/leads?status=<%= s %><%= filters.listingId ? '&listing=' + filters.listingId : '' %>"><%= STATUS_LABELS[s] %> <span class="lead-n"><%= counts[s] || 0 %></span></a>
        <% }) %>
        <a role="tab" aria-selected="<%= isArchived %>" class="lead-tab<%= isArchived ? ' on' : '' %>" href="/dashboard/leads?box=archived<%= filters.listingId ? '&listing=' + filters.listingId : '' %>">Archived <span class="lead-n"><%= counts.archived %></span></a>
      <% } %>
    </div>

    <% if (isSent && sentCounts.waiting) { %>
      <p class="lead-waiting-line"><b><%= sentCounts.waiting %></b> conversation<%= sentCounts.waiting === 1 ? '' : 's' %> with a reply from the business waiting for you.</p>
    <% } else if (!isSent && pro && counts.waiting) { %>
      <p class="lead-waiting-line"><b><%= counts.waiting %></b> inquiry<%= counts.waiting === 1 ? '' : 'ies' %> waiting for your reply.</p>
    <% } %>

    <% if (!isSent && !pro) { %>
      <div class="panel pro-locked" style="max-width:720px">
        <div class="plc-left">
          <span class="plc-lock" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
          <div>
            <h3 style="margin:0">Business inbox ✦ FirmLedger Pro</h3>
            <p style="font-size:13.5px;color:var(--muted);margin:.35rem 0 0">
              <% if (counts.total) { %>
                You have <b><%= counts.total %> waiting <%= counts.total === 1 ? 'inquiry' : 'inquiries' %></b><%= counts.new ? ` — ${counts.new} new` : '' %>. Inquiries keep arriving while you're on Free; reading, replying and managing them unlocks with Pro.
              <% } else { %>
                Every claimed listing carries a “Contact this business” button for signed-in members. Inquiries land here with statuses and a live chat thread. Nothing waiting yet — claim a listing and share it.
              <% } %>
            </p>
            <% if (sentCounts.total) { %>
            <p style="font-size:13.5px;color:var(--muted);margin:.5rem 0 0">You already have <b><%= sentCounts.total %></b> conversation<%= sentCounts.total === 1 ? '' : 's' %> you started — open the <a href="/dashboard/leads?box=sent">Sent</a> tab anytime.</p>
            <% } %>
          </div>
        </div>
        <div class="plc-actions">
          <a class="btn btn-accent btn-sm" href="/dashboard/upgrade">Upgrade to Pro</a>
          <a class="btn btn-ghost btn-sm" href="/pricing">See pricing</a>
        </div>
      </div>
    <% } else { %>
      <div class="lead-layout">
        <div class="lead-list-col">
          <% if (!box.rows.length) { %>
            <div class="empty-state">
              <h3><%= isSent ? 'No conversations yet' : isArchived ? 'Nothing archived' : filters.status ? 'No ' + STATUS_LABELS[filters.status].toLowerCase() + ' leads' : 'No inquiries yet' %></h3>
              <p><%= isSent
                ? 'When you contact a verified business from its listing page, the conversation appears here so you can keep talking.'
                : isArchived || filters.status
                  ? 'Try another filter — or clear it to see everything.'
                  : 'When a FirmLedger member contacts one of your claimed listings, the inquiry appears here.' %></p>
              <% if (!isSent && (isArchived || filters.status)) { %><a class="btn btn-ghost btn-sm" href="/dashboard/leads">Clear filters</a><% } %>
            </div>
          <% } else { %>
            <div class="lead-list lead-list-scroll">
              <% box.rows.forEach(function (ld) { %>
              <a class="lead-row<%= open && open.id === ld.id ? ' open' : '' %><%= !isSent && ld.status === 'new' ? ' is-new' : '' %>" href="<%= leadUrl(['open=' + ld.id]) %>">
                <span class="lead-row-main">
                  <span class="lead-row-title">
                    <b><%= isSent ? ld.listing_name : ld.name %></b>
                    <% if (!isSent) { %><span class="pill pill-lead-<%= ld.status %>"><%= STATUS_LABELS[ld.status] %></span><% } %>
                  </span>
                  <small class="muted"><%= ld.looking_for || (ld.message || '').slice(0, 80) %></small>
                  <small class="muted"><%= isSent ? ld.name : ld.listing_name %> · <%= fmtDate(ld.updated_at || ld.created_at) %></small>
                </span>
                <% if (isSent && ld.last_sender === 'owner') { %><span class="lead-wait">New reply</span><% } %>
              </a>
              <% }) %>
            </div>
            <% if (box.pages > 1) { %>
            <nav class="pagination" aria-label="Leads pages">
              <% if (box.page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= pageUrl(box.page - 1) %>">← Newer</a><% } %>
              <span class="results-line" style="margin:0">Page <%= box.page %> of <%= box.pages %></span>
              <% if (box.page < box.pages) { %><a class="btn btn-ghost btn-sm" href="<%= pageUrl(box.page + 1) %>">Older →</a><% } %>
            </nav>
            <% } %>
          <% } %>
        </div>

        <div class="lead-detail-col">
          <% if (open) { %>
          <div class="panel lead-detail">
            <% /* The status the owner last set is stated where it was set, so a
                  change is confirmed in the pane it came from — not only in the
                  list to the left after the chat is closed. */ %>
            <div class="panel-h-t">
              <h3><%= openRole === 'inquirer' ? open.listing_name : open.name %><% if (openRole === 'owner') { %> <span class="pill pill-lead-<%= open.status %>" data-lead-pill-current><%= STATUS_LABELS[open.status] %></span><% } %></h3>
              <a class="muted" style="font-size:.8rem" href="<%= leadUrl([]) %>">Close ✕</a>
            </div>
            <p class="muted" style="font-size:13px;margin-top:-4px">
              <% if (openRole === 'inquirer') { %>
                Conversation with <a href="/listing/<%= open.listing_slug %>"><%= open.listing_name %></a> · started <%= fmtDate(open.created_at) %>
              <% } else { %>
                For <a href="/listing/<%= open.listing_slug %>"><%= open.listing_name %></a> · <%= fmtDate(open.created_at) %><% if (open.city || open.country) { %> · <%= [open.city, open.country].filter(Boolean).join(', ') %><% } %>
              <% } %>
            </p>

            <% /* Contact facts as one compact strip instead of a three-row
                  table: same labels, same mailto/tel links, but the block
                  costs the conversation a couple of lines instead of a
                  hundred vertical pixels. */ %>
            <% if (openRole === 'owner' || open.looking_for) { %>
            <div class="lead-facts">
              <% if (openRole === 'owner') { %>
              <span class="lf"><span class="lf-k">Email</span><a class="lf-v" href="mailto:<%= open.email %>"><%= open.email %></a></span>
              <% if (open.phone) { %><span class="lf"><span class="lf-k">Phone</span><a class="lf-v" href="tel:<%= String(open.phone).replace(/\s/g, '') %>"><%= open.phone %></a></span><% } %>
              <% } %>
              <% if (open.looking_for) { %><span class="lf"><span class="lf-k">Looking for</span><b class="lf-v"><%= open.looking_for %></b></span><% } %>
            </div>
            <% } %>

            <div class="lead-thread" id="leadThread">
              <% if (openMessages && openMessages.length) { %>
                <% let lastDay = ''; %>
                <% openMessages.forEach(function (m) { %>
                  <% const day = String(m.created_at || '').slice(0, 10); %>
                  <% if (day && day !== lastDay) { lastDay = day; %>
                    <div class="lead-day"><%= fmtDate(day) %></div>
                  <% } %>
                  <% const mine = (openRole === 'owner' && m.sender === 'owner') || (openRole === 'inquirer' && m.sender === 'inquirer'); %>
                  <div class="lead-bubble<%= mine ? ' mine' : ' theirs' %>">
                    <div class="lead-bubble-who"><%= mine ? 'You' : (m.sender === 'owner' ? open.listing_name : open.name) %></div>
                    <div class="lead-bubble-text"><%- String(m.body || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\n/g, '<br>') %></div>
                    <div class="lead-bubble-meta"><%= String(m.created_at || '').slice(11, 16) || fmtDate(m.created_at) %></div>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="muted" style="font-size:13px;text-align:center;padding:18px 0">No messages yet — say hello below.</p>
              <% } %>
            </div>

            <% /* Composer + housekeeping share one pinned foot: on desktop it sticks
                  to the pane bottom like the site header sticks to the page top,
                  so Send is always reachable. Same forms, same margins — the
                  wrapper itself adds no height. */ %>
            <div class="lead-detail-foot">
            <% /* The composer carries its own explanation: a refused reply is
                  stated beside the Send button, in the box the member is
                  looking at, with the exact reason and the numbers. */ %>
            <form class="lead-reply-form<%= cerr ? ' has-error' : '' %>" method="post" action="/dashboard/leads/<%= open.id %>/reply"
                  data-draft-key="lead-<%= open.id %>-<%= openRole %>"
                  data-reply-state="<%= cerr ? 'error' : (typeof replySent !== 'undefined' && replySent ? 'sent' : 'idle') %>"
                  data-reason="<%= _attr(cerr) %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <%- ctxFields() %>
              <label class="sr-only" for="lead-reply-<%= open.id %>">Your message</label>
              <textarea class="input" id="lead-reply-<%= open.id %>" name="body" rows="2" required
                        data-min="<%= rMin %>" data-max="<%= rMax %>"
                        data-count="lead-reply-count-<%= open.id %>" data-error="lead-reply-error-<%= open.id %>"
                        aria-describedby="lead-reply-help-<%= open.id %><%= cerr ? ' lead-reply-error-' + open.id : '' %>"
                        placeholder="<%= openRole === 'owner' ? 'Reply to ' + open.name + '…' : 'Write a follow-up to ' + open.listing_name + '…' %>"></textarea>
              <div class="lead-reply-actions">
                <button class="btn btn-primary btn-sm" type="submit">Send message</button>
                <span class="lead-reply-count" id="lead-reply-count-<%= open.id %>">0/<%= nf(rMax) %></span>
                <% if (openRole === 'owner') { %>
                <a class="btn btn-ghost btn-sm" href="mailto:<%= open.email %>?subject=<%= encodeURIComponent('Re: your inquiry to ' + open.listing_name + (open.looking_for ? ' — ' + open.looking_for : '')) %>">Email instead</a>
                <% if (open.phone) { %><a class="btn btn-ghost btn-sm" href="tel:<%= String(open.phone).replace(/\s/g, '') %>">Call</a><% } %>
                <% } %>
              </div>
              <p class="lead-reply-help muted" id="lead-reply-help-<%= open.id %>">
                Between <%= nf(rMin) %> and <%= nf(rMax) %> characters — the counter turns amber near the limit and red past it, and nothing you type is cleared if a send is refused. The first message goes by email; every reply after that arrives as a FirmLedger notification.
              </p>
              <p class="lead-reply-error" id="lead-reply-error-<%= open.id %>" role="alert"<%= cerr ? '' : ' hidden' %>><% if (cerr) { %><span class="lre-text"><%= cerr %></span><% if (cerr.indexOf('Pro feature') > -1) { %> <a class="btn btn-accent btn-sm" href="/dashboard/upgrade">Upgrade to Pro</a><% } %><% } %></p>
            </form>

            <% /* Status, archive and delete share one line under the composer, so
                  the conversation above keeps as much of the pane as it can. */ %>
            <% if (openRole === 'inquirer' || openRole === 'owner') { %>
            <div class="lead-detail-bar">
            <% if (openRole === 'inquirer') { %>
            <form method="post" action="/dashboard/leads/<%= open.id %>/delete" onsubmit="return confirm('Delete this conversation from your Sent box? The business keeps its own record of the inquiry. This cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <%- ctxFields() %>
              <button class="btn btn-ghost btn-sm lead-delete-btn" type="submit">Delete conversation</button>
            </form>
            <% } %>

            <% if (openRole === 'owner') { %>
            <form class="lead-status-form" method="post" action="/dashboard/leads/<%= open.id %>/status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <%- ctxFields() %>
              <label><span>Status</span>
                <select class="input" name="status">
                  <% STATUSES.forEach(function (s) { %><option value="<%= s %>"<%= open.status === s ? ' selected' : '' %>><%= STATUS_LABELS[s] %></option><% }) %>
                </select>
              </label>
              <button class="btn btn-ghost btn-sm" type="submit">Update</button>
            </form>
            <form method="post" action="/dashboard/leads/<%= open.id %>/archive">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <%- ctxFields() %>
              <input type="hidden" name="archived" value="<%= open.archived ? '0' : '1' %>">
              <button class="btn btn-ghost btn-sm" type="submit"><%= open.archived ? 'Restore to inbox' : 'Archive' %></button>
            </form>
            <form method="post" action="/dashboard/leads/<%= open.id %>/delete" onsubmit="return confirm('Permanently delete this conversation and its whole thread for both sides? This cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <%- ctxFields() %>
              <button class="btn btn-ghost btn-sm lead-delete-btn" type="submit">Delete permanently</button>
            </form>
            <% } %>
            </div>
            <% } %>
            </div>
            <% /* The corner grip: drag diagonally to lengthen the conversation /
                  trade width with the list; arrows/HOME fine-tune, double-click
                  restores. Hidden on stacked screens and in print. */ %>
            <button type="button" class="lead-resize" data-lead-resize aria-label="Resize conversation pane (arrow keys adjust, double-click restores)">
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M10.5 1.5 L1.5 10.5 M10.5 5.2 L5.2 10.5 M10.5 8.6 L8.6 10.5"/></svg>
            </button>
          </div>
          <% } else if (box.rows.length) { %>
          <div class="panel lead-detail lead-detail-empty">
            <p class="muted"><%= isSent ? 'Select a conversation to keep talking with the business.' : 'Select an inquiry to read it, reply and set its status.' %></p>
          </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<script>
(function () {
  var t = document.getElementById('leadThread');
  if (t) t.scrollTop = t.scrollHeight;

  /* Stacked screens put the list above the chat, so picking a lead brings the
     conversation into view — selecting a row visibly opens the thread. */
  if (t && window.matchMedia && window.matchMedia('(max-width: 900px)').matches
      && /(^|[?&])open=/.test(location.search)) {
    var pane = t.closest('.lead-detail-col') || t;
    if (pane.scrollIntoView) pane.scrollIntoView({ block: 'start' });
  }

  var store = (function () {
    try { window.sessionStorage.setItem('__fl', '1'); window.sessionStorage.removeItem('__fl'); return window.sessionStorage; }
    catch (e) { return null; }
  })();
  var nf = function (n) { return Number(n).toLocaleString('en-US'); };

  Array.prototype.forEach.call(document.querySelectorAll('.lead-reply-form'), function (form) {
    var ta = form.querySelector('textarea[name="body"]');
    if (!ta) return;
    var min = parseInt(ta.getAttribute('data-min'), 10) || 1;
    var max = parseInt(ta.getAttribute('data-max'), 10) || 4000;
    var count = document.getElementById(ta.getAttribute('data-count'));
    var errEl = document.getElementById(ta.getAttribute('data-error'));
    var key = 'fl.leadReply.' + (form.getAttribute('data-draft-key') || 'x');
    var state = form.getAttribute('data-reply-state') || 'idle';
    var serverReason = form.getAttribute('data-reason') || '';

    /* A refused send must never cost a member their text: the draft lives in
       this tab for the round trip and is dropped once the message is stored. */
    var saved = null;
    if (store) {
      try { saved = store.getItem(key); } catch (e) { saved = null; }
      if (state === 'sent') { try { store.removeItem(key); } catch (e) {} }
      else if (saved && !ta.value.trim()) ta.value = saved;
    }

    /* A restored draft that now satisfies the rule needs no explanation left
       on screen — the box below is the only place a refusal is ever shown. */
    if (ta.value.trim().length >= min && ta.value.trim().length <= max) serverReason = '';

    /* An empty box is not a mistake until the member tries to send from it, so
       the warning only appears once something has actually been refused. */
    var touched = state === 'error' || !!ta.value.trim();

    /* Same trick as the support composer: the box stays small and only grows
       with what is typed, so the thread above keeps the pane. */
    function autoSize() {
      if (!ta.style) return; /* a detached node has nothing to size */
      ta.style.height = 'auto';
      ta.style.height = Math.min(ta.scrollHeight || 0, 160) + 'px';
    }

    /** The exact reason the message would not send — '' means it will. */
    function reason() {
      var n = ta.value.trim().length;
      if (!n) return 'Nothing to send yet — the message box is empty. Write your reply and Send will work again.';
      if (n < min) return 'Too short to send — a reply needs at least ' + min + ' characters and yours is ' + n + '. A word or two is enough.';
      if (n > max) return 'Too long to send — your reply is ' + nf(n) + ' characters and the limit is ' + nf(max) + '. Trim ' + nf(n - max) + ' of them and it goes through.';
      return '';
    }

    function paint() {
      var n = ta.value.trim().length;
      if (count) {
        count.textContent = nf(n) + '/' + nf(max);
        count.classList.toggle('is-over', n > max);
        count.classList.toggle('is-near', n <= max && n > Math.floor(max * 0.9));
      }
      var msg = reason();
      /* The browser would block the send with its own generic tooltip; stating
         the same rule here keeps the two from ever disagreeing. */
      try { ta.setCustomValidity(msg); } catch (e) {}
      /* The server's reason outranks the local guess: it knows what the POST
         actually tripped over (a deleted thread, the Pro gate, the cap). */
      var shown = serverReason || (touched ? msg : '');
      if (errEl) {
        errEl.innerHTML = '';
        if (shown) {
          var span = document.createElement('span');
          span.className = 'lre-text';
          span.textContent = shown;
          errEl.appendChild(span);
          if (/Pro feature/.test(shown)) {
            var up = document.createElement('a');
            up.className = 'btn btn-accent btn-sm';
            up.href = '/dashboard/upgrade';
            up.textContent = 'Upgrade to Pro';
            errEl.appendChild(up);
          }
        }
        errEl.hidden = !shown;
      }
      form.classList.toggle('has-error', !!shown);
      ta.setAttribute('aria-invalid', shown ? 'true' : 'false');
      autoSize();
    }

    ta.addEventListener('input', function () {
      touched = true;
      serverReason = '';
      paint();
      if (store) {
        try {
          if (ta.value.trim()) store.setItem(key, ta.value); else store.removeItem(key);
        } catch (e) { /* a full or blocked storage must not stop the send */ }
      }
    });
    ta.addEventListener('invalid', function (e) {
      /* Keep the explanation inline under the box — one message, not two. */
      e.preventDefault();
      touched = true;
      paint();
      ta.focus();
    });
    form.addEventListener('submit', function () { touched = true; paint(); });
    paint();
    if (state === 'error') { ta.focus(); }
  });

  /* Status is one change, not a change plus a button press. The Update button
     stays for keyboards, taps and scripts that never load. */
  Array.prototype.forEach.call(document.querySelectorAll('.lead-status-form'), function (f) {
    var sel = f.querySelector('select[name="status"]');
    if (!sel) return;
    sel.addEventListener('change', function () {
      f.classList.add('is-saving');
      var b = f.querySelector('button[type="submit"]');
      if (b) b.textContent = 'Saving…';
      f.submit();
    });
  });
})();
</script>

<script>
/* Leads inbox — fixed conversation + corner resize (desktop only).
   Three behaviours, all additive: with no stored size and no scroll the pane
   renders exactly as before.
   1. Dock: while the inbox section still fills the viewport but the pane top
      has scrolled past the header stop, the pane parks at top:84px exactly
      over its own grid slot (inline left/width), instead of sliding under
      the header. Scroll back up — or down to the footer — and it rejoins.
   2. Resize: the corner grip trades height (pane) against width (list
      column), clamped, and persists per browser.
   3. Keyboard: arrows adjust, Ctrl+Home and double-click restore. */
(function () {
  'use strict';
  var pane = document.querySelector('.lead-detail-col .lead-detail');
  var grip = document.querySelector('[data-lead-resize]');
  if (!pane || !grip) return;
  var col = pane.closest('.lead-detail-col');
  var layout = pane.closest('.lead-layout');
  var section = pane.closest('.leads-section');
  var mq = window.matchMedia ? window.matchMedia('(min-width: 901px)') : null;

  var KEY = 'fl.leadsPane.v1';
  var DOCK_TOP = 84;   /* header stop, matches the sticky pane top */
  var MIN_H = 420;     /* thread floor + foot always fit */
  var MAX_H = 1100;    /* past this a pane is just page */
  var MIN_LIST = 220;  /* rows stay readable — the shipped column min */
  var MIN_CONV = 440;  /* composer actions stay on one line */

  function desktop() {
    if (mq) return mq.matches;
    return (window.innerWidth || 0) >= 901;
  }
  function load() {
    try {
      var o = JSON.parse(window.localStorage.getItem(KEY) || '{}');
      return o && typeof o === 'object' ? o : {};
    } catch (e) { return {}; }
  }
  function save(s) {
    try { window.localStorage.setItem(KEY, JSON.stringify(s)); } catch (e) {}
  }
  var S = load(); /* { h, w } — user size, empty until first resize */

  /* Height: never shorter than the foot, never taller than the window
     (minus header + margin) or the absolute cap. */
  function clampH(h, vh) {
    h = Math.round(Number(h) || 0);
    var max = Math.min(MAX_H, Math.max(MIN_H, vh - 96));
    if (h < MIN_H) h = MIN_H;
    if (h > max) h = max;
    return h;
  }
  /* List width: rows keep 220px, the conversation keeps 440px plus the gap. */
  function clampW(w, layoutW) {
    w = Math.round(Number(w) || 0);
    var max = Math.max(MIN_LIST, layoutW - 16 - MIN_CONV);
    if (w < MIN_LIST) w = MIN_LIST;
    if (w > max) w = max;
    return w;
  }
  /* Docked while the slot has passed the header stop but the section still
     owns the viewport — never over the footer. */
  function shouldDock(colTop, secBottom, vh) {
    return colTop < DOCK_TOP && secBottom > vh + 40;
  }

  function applySize() {
    var vh = window.innerHeight || 800;
    var layoutW = layout ? layout.clientWidth : 1200;
    if (S.h) pane.style.setProperty('--lead-user-h', clampH(S.h, vh) + 'px');
    else pane.style.removeProperty('--lead-user-h');
    if (layout) {
      if (S.w) layout.style.setProperty('--lead-list-w', clampW(S.w, layoutW) + 'px');
      else layout.style.removeProperty('--lead-list-w');
    }
  }

  function undock() {
    if (!pane.classList.contains('is-docked')) return;
    pane.classList.remove('is-docked');
    pane.style.left = '';
    pane.style.width = '';
    pane.style.top = '';
    pane.style.maxHeight = '';
    if (col) col.style.minHeight = '';
  }
  function dockTick() {
    if (!desktop() || !col || !section) { undock(); return; }
    var vh = window.innerHeight || 800;
    if (!shouldDock(col.getBoundingClientRect().top, section.getBoundingClientRect().bottom, vh)) {
      undock();
      return;
    }
    /* Park over the slot: the column rect is the slot even while docked. */
    var r = col.getBoundingClientRect();
    if (!pane.classList.contains('is-docked')) {
      pane.classList.add('is-docked');
      /* Hold the slot open behind the parked pane — no page jump. */
      col.style.minHeight = pane.offsetHeight + 'px';
    }
    pane.style.left = r.left + 'px';
    pane.style.width = r.width + 'px';
    pane.style.top = DOCK_TOP + 'px';
    /* A parked pane always fits the window, so the pinned foot is visible. */
    pane.style.maxHeight = Math.max(MIN_H, vh - DOCK_TOP - 12) + 'px';
  }

  /* --- corner drag: down lengthens, right widens the conversation --- */
  var drag = null;
  grip.addEventListener('pointerdown', function (e) {
    if (!desktop()) return;
    e.preventDefault();
    try { grip.setPointerCapture(e.pointerId); } catch (err) {}
    drag = { x: e.clientX, y: e.clientY, h: S.h || pane.offsetHeight, w: S.w || 300 };
    pane.classList.add('is-resizing');
    document.body.classList.add('is-lead-resizing');
  });
  grip.addEventListener('pointermove', function (e) {
    if (!drag) return;
    S.h = clampH(drag.h + (e.clientY - drag.y), window.innerHeight || 800);
    S.w = clampW(drag.w - (e.clientX - drag.x), layout ? layout.clientWidth : 1200);
    applySize();
    dockTick(); /* re-park over the slot as the grid trades width */
  });
  function endDrag() {
    if (!drag) return;
    drag = null;
    pane.classList.remove('is-resizing');
    document.body.classList.remove('is-lead-resizing');
    save(S);
    dockTick();
  }
  grip.addEventListener('pointerup', endDrag);
  grip.addEventListener('pointercancel', endDrag);

  /* --- keyboard: arrows nudge (Shift = big step), Ctrl+Home restores --- */
  grip.addEventListener('keydown', function (e) {
    if (!desktop()) return;
    var step = e.shiftKey ? 80 : 20;
    var handled = true;
    var h = S.h || pane.offsetHeight;
    var w = S.w || 300;
    if (e.key === 'ArrowDown') h += step;
    else if (e.key === 'ArrowUp') h -= step;
    else if (e.key === 'ArrowRight') w -= step;
    else if (e.key === 'ArrowLeft') w += step;
    else if (e.key === 'Home' && (e.ctrlKey || e.metaKey)) S = {};
    else handled = false;
    if (!handled) return; /* plain Home still scrolls to top */
    e.preventDefault();
    if (e.key !== 'Home') {
      S.h = clampH(h, window.innerHeight || 800);
      S.w = clampW(w, layout ? layout.clientWidth : 1200);
    }
    save(S);
    applySize();
    dockTick();
  });
  grip.addEventListener('dblclick', function (e) {
    e.preventDefault();
    S = {};
    save(S);
    applySize();
    dockTick();
  });

  var ticking = false;
  function requestDock() {
    if (ticking) return;
    ticking = true;
    (window.requestAnimationFrame || function (f) { setTimeout(f, 16); })(function () {
      ticking = false;
      dockTick();
    });
  }
  window.addEventListener('scroll', requestDock, { passive: true });
  window.addEventListener('resize', function () { applySize(); requestDock(); });
  if (mq) {
    var onMQ = function () { undock(); applySize(); requestDock(); };
    if (mq.addEventListener) mq.addEventListener('change', onMQ);
    else if (mq.addListener) mq.addListener(onMQ);
  }
  window.addEventListener('beforeprint', undock);
  window.addEventListener('afterprint', requestDock);

  applySize();
  dockTick();

  /* Test seam: pure geometry + state, no DOM needed except reset. */
  window.__flLeadsPane = {
    clampH: clampH,
    clampW: clampW,
    shouldDock: shouldDock,
    key: KEY,
    dockTop: DOCK_TOP,
    state: function () { return { h: S.h || null, w: S.w || null }; },
    reset: function () { S = {}; save(S); applySize(); dockTick(); }
  };
})();
</script>

