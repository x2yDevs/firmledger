<%- include('../partials/top') %>

<%
  /* Keep the current filters on every link inside the inbox. */
  const _fq = [];
  if (filters.box === 'sent') _fq.push('box=sent');
  else {
    if (filters.status) _fq.push('status=' + encodeURIComponent(filters.status));
    if (filters.listingId) _fq.push('listing=' + encodeURIComponent(filters.listingId));
    if (filters.archived) _fq.push('box=archived');
  }
  const _fqs = _fq.length ? _fq.join('&') + '&' : '';
  const isSent = filters.box === 'sent';
  const isArchived = filters.archived;
%>
<section class="page-head">
  <div class="container dash-head">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/dashboard">Dashboard</a><span aria-hidden="true">›</span><span>Leads</span></nav>
      <h1>Leads inbox</h1>
      <p class="muted">Talk with verified businesses you contacted — and manage inquiries on listings you own. Your FirmLedger email is used automatically; the business email stays private.</p>
    </div>
    <% if (pro && !isSent) { %>
    <form class="ana-pick fl-select" method="get" action="/dashboard/leads">
      <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
      <% if (filters.archived) { %><input type="hidden" name="box" value="archived"><% } %>
      <label><span class="muted" style="font-size:12.5px">Listing</span>
        <select class="input" name="listing" onchange="this.form.submit()">
          <option value="">All listings</option>
          <% listings.forEach(function (gl) { %><option value="<%= gl.id %>"<%= Number(filters.listingId) === gl.id ? ' selected' : '' %>><%= gl.name %></option><% }) %>
        </select>
      </label>
    </form>
    <% } %>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <% if (typeof ok !== 'undefined' && ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
    <% if (typeof err !== 'undefined' && err) { %><div class="alert alert-err"><%= err %></div><% } %>

    <div class="lead-tabs" role="tablist" aria-label="Lead boxes">
      <a role="tab" aria-selected="<%= !isSent && !isArchived && !filters.status %>" class="lead-tab<%= !isSent && !isArchived && !filters.status ? ' on' : '' %>" href="/dashboard/leads<%= filters.listingId ? '?listing=' + filters.listingId : '' %>">Received <span class="lead-n"><%= counts.total %></span><% if (counts.unread) { %><span class="lead-unread" title="<%= counts.unread %> unread message<%= counts.unread === 1 ? '' : 's' %>"><%= counts.unread %> new</span><% } %></a>
      <a role="tab" aria-selected="<%= isSent %>" class="lead-tab<%= isSent ? ' on' : '' %>" href="/dashboard/leads?box=sent">Sent <span class="lead-n"><%= sentCounts.total %></span><% if (sentCounts.unread) { %><span class="lead-unread" title="<%= sentCounts.unread %> unread repl<%= sentCounts.unread === 1 ? 'y' : 'ies' %>"><%= sentCounts.unread %> new</span><% } %></a>
      <% if (pro && !isSent) { %>
        <% STATUSES.forEach(function (s) { %>
        <a role="tab" aria-selected="<%= filters.status === s && !isArchived %>" class="lead-tab<%= filters.status === s && !isArchived ? ' on' : '' %>" href="/dashboard/leads?status=<%= s %><%= filters.listingId ? '&listing=' + filters.listingId : '' %>"><%= STATUS_LABELS[s] %> <span class="lead-n"><%= counts[s] || 0 %></span></a>
        <% }) %>
        <a role="tab" aria-selected="<%= isArchived %>" class="lead-tab<%= isArchived ? ' on' : '' %>" href="/dashboard/leads?box=archived<%= filters.listingId ? '&listing=' + filters.listingId : '' %>">Archived <span class="lead-n"><%= counts.archived %></span></a>
      <% } %>
    </div>

    <% if (!isSent && !pro) { %>
      <div class="panel pro-locked" style="max-width:720px">
        <div class="plc-left">
          <span class="plc-lock" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
          <div>
            <h3 style="margin:0">Business inbox ✦ FirmLedger Pro</h3>
            <p style="font-size:13.5px;color:var(--muted);margin:.35rem 0 0">
              <% if (counts.total) { %>
                You have <b><%= counts.total %> waiting <%= counts.total === 1 ? 'inquiry' : 'inquiries' %></b><%= counts.new ? ` — ${counts.new} new` : '' %>. Inquiries keep arriving while you're on Free; reading, replying and managing them unlocks with Pro.
              <% } else { %>
                Every claimed listing carries a “Contact this business” button for signed-in members. Inquiries land here with statuses, live chat and notes. Nothing waiting yet — claim a listing and share it.
              <% } %>
            </p>
            <% if (sentCounts.total) { %>
            <p style="font-size:13.5px;color:var(--muted);margin:.5rem 0 0">You already have <b><%= sentCounts.total %></b> conversation<%= sentCounts.total === 1 ? '' : 's' %> you started — open the <a href="/dashboard/leads?box=sent">Sent</a> tab anytime.</p>
            <% } %>
          </div>
        </div>
        <div class="plc-actions">
          <a class="btn btn-accent btn-sm" href="/dashboard/upgrade">Upgrade to Pro</a>
          <a class="btn btn-ghost btn-sm" href="/pricing">See pricing</a>
        </div>
      </div>
    <% } else { %>
      <div class="lead-layout">
        <div class="lead-list-col">
          <% if (!box.rows.length) { %>
            <div class="empty-state">
              <h3><%= isSent ? 'No conversations yet' : isArchived ? 'Nothing archived' : filters.status ? 'No ' + STATUS_LABELS[filters.status].toLowerCase() + ' leads' : 'No inquiries yet' %></h3>
              <p><%= isSent
                ? 'When you contact a verified business from its listing page, the conversation appears here so you can keep talking.'
                : isArchived || filters.status
                  ? 'Try another filter — or clear it to see everything.'
                  : 'When a FirmLedger member contacts one of your claimed listings, the inquiry appears here.' %></p>
              <% if (!isSent && (isArchived || filters.status)) { %><a class="btn btn-ghost btn-sm" href="/dashboard/leads">Clear filters</a><% } %>
            </div>
          <% } else { %>
            <div class="lead-list lead-list-scroll">
              <% box.rows.forEach(function (ld) { %>
              <%
                /* Unread is per side: what the OTHER party has said since this
                   one last opened the thread. It is the real signal — status
                   only ever described the business's own pipeline stage. */
                const unread = Number(isSent ? ld.inquirer_unread : ld.owner_unread) || 0;
                /* Preview the latest message, not the opening one, so a live
                   conversation reads like a conversation. */
                const preview = ld.last_body || ld.message || '';
                const mineLast = (isSent && ld.last_sender === 'inquirer') || (!isSent && ld.last_sender === 'owner');
              %>
              <a class="lead-row<%= open && open.id === ld.id ? ' open' : '' %><%= unread ? ' is-unread' : '' %><%= !isSent && ld.status === 'new' ? ' is-new' : '' %>" href="/dashboard/leads?<%= _fqs %>open=<%= ld.id %>">
                <span class="lead-row-main">
                  <b><%= isSent ? ld.listing_name : ld.name %><% if (unread) { %> <span class="lead-dot" aria-label="<%= unread %> unread message<%= unread === 1 ? '' : 's' %>"></span><% } %></b>
                  <small class="muted"><%= ld.looking_for || preview.slice(0, 80) %></small>
                  <small class="muted"><% if (preview && ld.looking_for) { %><%= mineLast ? 'You: ' : '' %><%= preview.slice(0, 60) %> · <% } %><%= fmtDate(ld.updated_at || ld.created_at) %></small>
                </span>
                <span class="lead-row-side">
                  <% if (unread) { %><span class="pill pill-lead-unread"><%= unread %> new</span><% } %>
                  <% if (!isSent) { %><span class="pill pill-lead-<%= ld.status %>"><%= STATUS_LABELS[ld.status] %></span><% } %>
                </span>
              </a>
              <% }) %>
            </div>
            <% if (box.pages > 1) { %>
            <nav class="pagination" aria-label="Leads pages">
              <% if (box.page > 1) { %><a class="btn btn-ghost btn-sm" href="/dashboard/leads?<%= _fqs %>page=<%= box.page - 1 %>">← Newer</a><% } %>
              <span class="results-line" style="margin:0">Page <%= box.page %> of <%= box.pages %></span>
              <% if (box.page < box.pages) { %><a class="btn btn-ghost btn-sm" href="/dashboard/leads?<%= _fqs %>page=<%= box.page + 1 %>">Older →</a><% } %>
            </nav>
            <% } %>
          <% } %>
        </div>

        <div class="lead-detail-col">
          <% if (open) { %>
          <div class="panel lead-detail">
            <div class="panel-h-t">
              <h3><%= openRole === 'inquirer' ? open.listing_name : open.name %></h3>
              <a class="muted" style="font-size:.8rem" href="/dashboard/leads<%= _fqs ? '?' + _fqs.replace(/&$/, '') : '' %>">Close ✕</a>
            </div>
            <p class="muted" style="font-size:13px;margin-top:-4px">
              <% if (openRole === 'inquirer') { %>
                Conversation with <a href="/listing/<%= open.listing_slug %>"><%= open.listing_name %></a> · started <%= fmtDate(open.created_at) %>
              <% } else { %>
                For <a href="/listing/<%= open.listing_slug %>"><%= open.listing_name %></a> · <%= fmtDate(open.created_at) %><% if (open.city || open.country) { %> · <%= [open.city, open.country].filter(Boolean).join(', ') %><% } %>
              <% } %>
            </p>

            <% if (openRole === 'owner' && open.archived) { %>
            <p class="lead-archived-note">Archived — it stays out of your inbox until the customer writes again.</p>
            <% } %>

            <% if (openRole === 'owner') { %>
            <table class="facts">
              <tr><th>Email</th><td><a href="mailto:<%= open.email %>" style="color:var(--accent2)"><%= open.email %></a></td></tr>
              <% if (open.phone) { %><tr><th>Phone</th><td><a href="tel:<%= String(open.phone).replace(/\s/g, '') %>" style="color:var(--accent2)"><%= open.phone %></a></td></tr><% } %>
              <% if (open.looking_for) { %><tr><th>Looking for</th><td><%= open.looking_for %></td></tr><% } %>
            </table>
            <% } else if (open.looking_for) { %>
            <p style="font-size:13.5px;margin:8px 0 0"><span class="muted">Looking for:</span> <b><%= open.looking_for %></b></p>
            <% } %>

            <%
              /* openUnread is how many messages arrived since this side last
                 opened the thread; mark exactly where they left off. */
              const _unread = Number(typeof openUnread !== 'undefined' ? openUnread : 0) || 0;
              const _firstUnread = _unread > 0 ? Math.max(0, (openMessages || []).length - _unread) : -1;
            %>
            <div class="lead-thread" id="leadThread">
              <% if (openMessages && openMessages.length) { %>
                <% let lastDay = ''; %>
                <% openMessages.forEach(function (m, i) { %>
                  <% const day = String(m.created_at || '').slice(0, 10); %>
                  <% if (day && day !== lastDay) { lastDay = day; %>
                    <div class="lead-day"><%= fmtDate(day) %></div>
                  <% } %>
                  <% if (i === _firstUnread) { %>
                    <div class="lead-day lead-new-line" id="leadNewLine"><%= _unread %> new message<%= _unread === 1 ? '' : 's' %></div>
                  <% } %>
                  <% const mine = (openRole === 'owner' && m.sender === 'owner') || (openRole === 'inquirer' && m.sender === 'inquirer'); %>
                  <div class="lead-bubble<%= mine ? ' mine' : ' theirs' %>">
                    <div class="lead-bubble-who"><%= mine ? 'You' : (m.sender === 'owner' ? open.listing_name : open.name) %></div>
                    <div class="lead-bubble-text"><%- String(m.body || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\n/g, '<br>') %></div>
                    <div class="lead-bubble-meta"><%= String(m.created_at || '').slice(11, 16) || fmtDate(m.created_at) %></div>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="muted" style="font-size:13px;text-align:center;padding:18px 0">No messages yet.</p>
              <% } %>
            </div>

            <%
              /* The member can delete their copy of a conversation; the business
                 keeps the record but there is nobody left to receive a reply.
                 Never show a live reply box that quietly writes to nowhere. */
              const _detached = openRole === 'owner' && !open.inquirer_user_id;
            %>
            <% if (_detached) { %>
            <div class="alert alert-info lead-detached" role="status">
              <b><%= open.name %></b> deleted this conversation from their FirmLedger account, so they can no longer receive replies here. The inquiry stays on your record.
              <% if (open.email) { %><br>Reach them directly at <a href="mailto:<%= open.email %>?subject=<%= encodeURIComponent('Re: your inquiry to ' + open.listing_name + (open.looking_for ? ' — ' + open.looking_for : '')) %>"><%= open.email %></a><% if (open.phone) { %> or <a href="tel:<%= String(open.phone).replace(/\s/g, '') %>"><%= open.phone %></a><% } %>.<% } %>
            </div>
            <% } else { %>
            <form class="lead-reply-form" method="post" action="/dashboard/leads/<%= open.id %>/reply">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="sr-only" for="lead-reply-<%= open.id %>">Your message</label>
              <textarea class="input" id="lead-reply-<%= open.id %>" name="body" rows="3" maxlength="<%= typeof MESSAGE_MAX !== 'undefined' ? MESSAGE_MAX : 4000 %>" required placeholder="<%= openRole === 'owner' ? 'Reply to ' + open.name + '…' : 'Write a follow-up to ' + open.listing_name + '…' %>"></textarea>
              <div class="lead-reply-actions">
                <button class="btn btn-primary btn-sm" type="submit">Send message</button>
                <% if (openRole === 'owner') { %>
                <a class="btn btn-ghost btn-sm" href="mailto:<%= open.email %>?subject=<%= encodeURIComponent('Re: your inquiry to ' + open.listing_name + (open.looking_for ? ' — ' + open.looking_for : '')) %>">Email instead</a>
                <% if (open.phone) { %><a class="btn btn-ghost btn-sm" href="tel:<%= String(open.phone).replace(/\s/g, '') %>">Call</a><% } %>
                <% } %>
              </div>
              <p class="muted" style="font-size:12px;margin:8px 0 0">The first message of a conversation goes by email; every reply after that arrives as a FirmLedger notification.</p>
            </form>
            <% } %>

            <% if (openRole === 'inquirer') { %>
            <form method="post" action="/dashboard/leads/<%= open.id %>/delete" style="margin-top:10px" onsubmit="return confirm('Delete this conversation from your Sent box? The business keeps its own record of the inquiry. This cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-ghost btn-sm lead-delete-btn" type="submit">Delete conversation</button>
            </form>
            <% } %>

            <% if (openRole === 'owner') { %>
            <form class="lead-status-form" method="post" action="/dashboard/leads/<%= open.id %>/status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label><span>Status</span>
                <select class="input" name="status">
                  <% STATUSES.forEach(function (s) { %><option value="<%= s %>"<%= open.status === s ? ' selected' : '' %>><%= STATUS_LABELS[s] %></option><% }) %>
                </select>
              </label>
              <button class="btn btn-ghost btn-sm" type="submit">Update</button>
            </form>
            <form method="post" action="/dashboard/leads/<%= open.id %>/archive" style="margin-top:10px">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="archived" value="<%= open.archived ? '0' : '1' %>">
              <button class="btn btn-ghost btn-sm" type="submit"><%= open.archived ? 'Restore to inbox' : 'Archive' %></button>
            </form>
            <form method="post" action="/dashboard/leads/<%= open.id %>/delete" style="margin-top:10px" onsubmit="return confirm('Permanently delete this conversation, its messages and notes for both sides? This cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-ghost btn-sm lead-delete-btn" type="submit">Delete permanently</button>
            </form>

            <div class="lead-notes-block">
              <h4 class="h-section">Private notes <span class="muted" style="font-weight:400">· only you see these</span></h4>
              <div class="lead-notes-area">
                <% if (openNotes.length) { %>
                <ul class="lead-notes">
                  <% openNotes.forEach(function (n) { %>
                  <li><p><%= n.note %></p><small class="muted"><%= fmtDate(n.created_at) %></small></li>
                  <% }) %>
                </ul>
                <% } else { %>
                <p class="muted" style="font-size:13px">No notes yet — record calls, quotes and follow-ups here.</p>
                <% } %>
              </div>
              <form class="lead-note-form" method="post" action="/dashboard/leads/<%= open.id %>/note">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label><span class="sr-only">Add a note</span><textarea class="input" name="note" rows="2" maxlength="2000" required placeholder="Add a private note…"></textarea></label>
                <button class="btn btn-ghost btn-sm" type="submit">Add note</button>
              </form>
            </div>
            <% } %>
          </div>
          <% } else if (box.rows.length) { %>
          <div class="panel lead-detail lead-detail-empty">
            <p class="muted"><%= isSent ? 'Select a conversation to keep talking with the business.' : 'Select an inquiry to read it, reply, set its status and add notes.' %></p>
          </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<script>
(function () {
  'use strict';
  var t = document.getElementById('leadThread');
  if (!t) return;
  /* Land on the first unread message when there is one, otherwise on the
     newest — the same rule every mail client uses. */
  var line = document.getElementById('leadNewLine');
  if (line) t.scrollTop = Math.max(0, line.offsetTop - 12);
  else t.scrollTop = t.scrollHeight;

  /* Reply box: never let a double-click send the same message twice. */
  var form = document.querySelector('.lead-reply-form');
  if (!form) return;
  form.addEventListener('submit', function () {
    var btn = form.querySelector('button[type="submit"]');
    var box = form.querySelector('textarea');
    if (!btn || btn.disabled) return;
    if (typeof form.checkValidity === 'function' && !form.checkValidity()) return;
    if (box && !box.value.trim()) return;
    btn.disabled = true;
    btn.textContent = 'Sending…';
  });
})();
</script>

<%- include('../partials/bottom') %>
