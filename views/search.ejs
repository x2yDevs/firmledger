<%- include('partials/top') %>

<div class="container page-pad">
  <div class="sec-head rv">
    <div class="l">
      <p class="klabel">Site search</p>
      <h2>Search FirmLedger</h2>
      <p>One query across business profiles, the blog and the documentation.</p>
    </div>
    <span class="idx">SEARCH</span>
  </div>

  <form class="search-hero rv" method="get" action="/search" role="search">
    <input class="input search-hero-in" type="search" name="q" value="<%= q %>" placeholder="Company, person, product, topic…" autofocus>
    <button class="btn btn-gold" type="submit">Search</button>
  </form>

  <% if (q) { %>
  <p class="search-count rv"><%= total %> result<%= total === 1 ? '' : 's' %> for “<%= q %>”</p>

  <div class="search-groups">
    <section class="search-group rv">
      <h3>Business profiles <span class="sg-n"><%= providers.length %></span></h3>
      <% if (!providers.length) { %><p class="muted">No matching profiles.</p><% } %>
      <% providers.forEach(function(l){ %>
      <a class="search-row" href="/listing/<%= l.slug %>">
        <% if (l.logo_url) { %><img src="<%= l.logo_url %>" alt="" width="34" height="34" loading="lazy"><% } else { %><span class="ph"><%= initials(l.name) %></span><% } %>
        <span class="sr-t"><b><%= l.name %><% if (perksActive(l)) { %> <span class="ptick ptick-sm" title="FirmLedger Pro — enhanced verified profile"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 2.4 3.3-.5 1 3.3L22 9l-1.7 3 1.7 3-3.3 1.8-1 3.3-3.3-.5L12 22l-2.4-2.4-3.3.5-1-3.3L2 15l1.7-3L2 9l3.3-1.8 1-3.3 3.3.5L12 2z" fill="#1D4ED8"/><path d="M10.6 15.4l-3-3 1.5-1.5 1.5 1.5 4.3-4.3 1.5 1.5-5.8 5.8z" fill="#fff"/></svg></span><% } %></b><small><%= l.category %> · <%= l.type %> · <%= [l.city,l.country].filter(Boolean).join(', ') || '—' %></small></span>
        <span class="sr-arrow">&rsaquo;</span>
      </a>
      <% }); %>
      <% if (providers.length === 5) { %><p style="margin-top:10px"><a href="/directory?q=<%= encodeURIComponent(q) %>">Browse all matches in the directory &rsaquo;</a></p><% } %>
    </section>

    <section class="search-group rv">
      <h3>Blog <span class="sg-n"><%= posts.length %></span></h3>
      <% if (!posts.length) { %><p class="muted">No matching posts.</p><% } %>
      <% posts.forEach(function(p){ %>
      <a class="search-row" href="/blog/<%= p.slug %>">
        <span class="sr-t"><b><%= p.title %></b><small><%= p.excerpt %></small></span>
        <span class="sr-arrow">&rsaquo;</span>
      </a>
      <% }); %>
    </section>

    <section class="search-group rv">
      <h3>Documentation <span class="sg-n"><%= docs.length %></span></h3>
      <% if (!docs.length) { %><p class="muted">No matching documentation.</p><% } %>
      <% docs.forEach(function(d){ %>
      <a class="search-row" href="/docs#<%= d.id %>">
        <span class="sr-t"><b><%= d.title %></b><small><%= d.lede %></small></span>
        <span class="sr-arrow">&rsaquo;</span>
      </a>
      <% }); %>
    </section>
  </div>
  <% } %>
</div>

<%- include('partials/bottom') %>
