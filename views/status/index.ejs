<%- include('../partials/top') %>

<section class="page-head">
  <div class="container" style="text-align:center">
    <p class="kicker kicker-center">System status</p>
    <h1 class="h-display">FirmLedger <em style="font-style:normal;color:var(--accent2)">status</em></h1>
    <p class="lede" style="margin-left:auto;margin-right:auto">Live operational status of the FirmLedger platform — the web application, API, database and email delivery.</p>
  </div>
</section>

<section class="section-tight st-section">
  <div class="container st-container">
    <% if (ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
    <% if (err) { %><div class="alert alert-err"><%= err %></div><% } %>

    <!-- Auto-refresh controls -->
    <div class="st-refresh rv" role="region" aria-label="Status auto-refresh">
      <div>
        <span class="st-refresh-status" id="st-refresh-status">Auto-refresh is on — this page updates itself.</span>
        <button type="button" class="btn btn-ghost btn-sm" id="st-refresh-now">Refresh now</button>
        <button type="button" class="btn btn-ghost btn-sm" id="st-refresh-toggle" data-on="1">Auto-refresh: on</button>
      </div>
    </div>

    <!-- Overall status hero -->
    <div class="st-hero rv st-<%= snap.status %>" id="st-hero" data-status="<%= snap.status %>" role="status" aria-live="polite">
      <div class="st-hero-dot" aria-hidden="true"></div>
      <div>
        <h2 class="st-hero-title" id="st-hero-title"><%= labels[snap.status] %></h2>
        <p class="st-hero-sub" id="st-hero-sub">
          <% if (snap.active_incidents.length) { %>
            <b><%= snap.active_incidents.length %> active incident<%= snap.active_incidents.length === 1 ? '' : 's' %></b> — we're on it.
          <% } else if (snap.status === 'operational') { %>
            All monitored systems are up and responding normally.
          <% } else { %>
            Some systems are experiencing issues. We're working to restore normal service.
          <% } %>
        </p>
      </div>
      <div class="st-hero-meta">
        <span class="st-meta-label">Last checked</span>
        <span class="st-meta-val" id="st-last-checked"><%= (snap.last_checked || snap.timestamp || '').slice(0, 16).replace('T', ' ') %> UTC</span>
      </div>
    </div>

    <!-- Uptime summary -->
    <div class="st-uptime rv" style="--d:60ms">
      <span class="st-up-label">Uptime</span>
      <div class="st-up-cell" data-uptime-cell="24h"><span class="st-up-n"><%= snap.uptime['24h'] %>%</span><span class="st-up-l">24h</span></div>
      <div class="st-up-cell" data-uptime-cell="7d"><span class="st-up-n"><%= snap.uptime['7d'] %>%</span><span class="st-up-l">7d</span></div>
      <div class="st-up-cell" data-uptime-cell="30d"><span class="st-up-n"><%= snap.uptime['30d'] %>%</span><span class="st-up-l">30d</span></div>
      <div class="st-up-cell" data-uptime-cell="90d"><span class="st-up-n"><%= snap.uptime['90d'] %>%</span><span class="st-up-l">90d</span></div>
    </div>

    <!-- Components -->
    <div class="st-components rv" style="--d:120ms">
      <h3 class="h-section" style="margin-bottom:14px">Components</h3>
      <% snap.components.forEach(function (c) { %>
      <div class="st-component" data-comp="<%= c.slug %>">
        <div class="st-cmp-name">
          <span class="st-dot st-dot-<%= c.status %>" data-comp-dot="<%= c.status %>" aria-hidden="true"></span>
          <div>
            <div class="st-cmp-title"><%= c.name %></div>
            <div class="st-cmp-desc"><%= c.description %></div>
          </div>
        </div>
        <div class="st-cmp-status">
          <span class="st-pill st-pill-<%= c.status %>" data-comp-pill="<%= c.status %>"><%= c.status_label %></span>
          <div class="st-cmp-uptime">
            <% ['24h', '7d', '30d', '90d'].forEach(function (k) { %>
            <span class="st-cmp-up" data-uptime="<%= k %>"><i class="st-bar st-bar-<%= c.uptime[k] >= 99 ? 'ok' : 'warn' %>" style="width:<%= c.uptime[k] %>%"></i><span class="st-cmp-num"><%= c.uptime[k] %>%</span></span>
            <% }); %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>

    <!-- Subscribe -->
    <div class="st-subscribe rv" id="subscribe" style="--d:180ms">
      <div>
        <h3 class="st-sub-title">Get status updates by email</h3>
        <p class="muted" style="margin:4px 0 0">Subscribe and we'll email you when something is down and when it's fixed. One click to confirm, one to cancel.</p>
      </div>
      <form method="post" action="/status/subscribe" class="st-sub-form">
        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
        <input type="email" name="email" required placeholder="you@company.com" aria-label="Your email for status updates" maxlength="254">
        <button class="btn btn-primary" type="submit">Subscribe</button>
      </form>
    </div>

    <% if (snap.incidents_30d.length) { %>
    <!-- Incident history -->
    <div class="st-incidents rv" style="--d:240ms">
      <h3 class="h-section" style="margin-bottom:6px">Incident history</h3>
      <p class="muted" style="margin:0 0 18px">The last 30 days of incidents and their resolution timelines.</p>
      <% snap.incidents_30d.forEach(function (inc) { %>
      <article class="st-incident">
        <div class="st-inc-head">
          <div>
            <h4 class="st-inc-title"><%= inc.title %></h4>
            <div class="st-inc-meta">
              <span class="st-pill st-pill-sev-<%= inc.severity %>"><%= inc.severity %></span>
              <% if (inc.component_name) { %><span class="st-inc-cmp"><%= inc.component_name %></span><% } %>
              <span class="st-inc-date"><%= (inc.created_at || '').slice(0, 10) %></span>
            </div>
          </div>
          <span class="st-pill st-pill-<%= inc.status === 'resolved' ? 'operational' : (inc.status === 'monitoring' ? 'degraded' : 'partial_outage') %>"><%= inc.status %></span>
        </div>
        <% if (inc.description) { %><p class="st-inc-desc"><%= inc.description %></p><% } %>
        <div class="st-timeline">
          <% inc.updates.forEach(function (u) { %>
          <div class="st-tl-row">
            <span class="st-tl-dot st-tl-dot-<%= u.status === 'resolved' ? 'ok' : (u.status === 'monitoring' ? 'warn' : 'err') %>" aria-hidden="true"></span>
            <div>
              <div class="st-tl-status"><%= u.status %></div>
              <div class="st-tl-msg"><%= u.message %></div>
            </div>
            <span class="st-tl-time"><%= (u.created_at || '').slice(0, 16).replace('T', ' ') %></span>
          </div>
          <% }); %>
        </div>
      </article>
      <% }); %>
    </div>
    <% } else { %>
    <div class="st-noincidents rv" style="--d:240ms">
      <div class="st-inc-title" style="margin-bottom:6px">No incidents in the last 30 days</div>
      <p class="muted" style="margin:0">FirmLedger has been running smoothly. We'll post here the moment anything changes.</p>
    </div>
    <% } %>

    <!-- What this page monitors -->
    <div class="st-subscribe rv" style="--d:300ms">
      <div>
        <h3 class="st-sub-title">What we monitor</h3>
        <p class="muted" style="margin:4px 0 0">Every component below is probed from outside the platform: the web application, the REST API, the database, background jobs and email delivery. Each probe records latency and success, and the uptime figures on this page are calculated from the actual checks — not estimates.</p>
        <p class="muted" style="margin:4px 0 0"><b>24h / 7d / 30d / 90d</b> uptime is the percentage of successful checks in each window. A component is marked degraded when checks fail or time out, and an incident is opened the moment a degradation is detected.</p>
      </div>
    </div>

    <!-- How alerts work -->
    <div class="st-subscribe rv" id="how-it-works" style="--d:360ms">
      <div>
        <h3 class="st-sub-title">How you'll hear about problems</h3>
        <p class="muted" style="margin:4px 0 0">Subscribe above and we email you when an incident opens and again when it resolves — one confirmation click, one click to stop. You'll never receive routine updates: no daily digests, no “all clear” noise unless something actually changed.</p>
        <p class="muted" style="margin:4px 0 0">For teams that need programmatic access, the same live snapshot is available as JSON at <a href="/status/api" style="color:var(--accent2)"><code>/status/api</code></a>.</p>
      </div>
    </div>

    <!-- Trust & transparency -->
    <div class="st-subscribe rv" style="--d:420ms">
      <div>
        <h3 class="st-sub-title">Why we publish this page</h3>
        <p class="muted" style="margin:4px 0 0">FirmLedger is the record layer for business discovery — companies depend on our profiles, our API and our verification. Publishing real status, real incident timelines and real uptime numbers is part of the same promise we make with our data: <b>source-backed, verifiable, honest</b>. If something is degraded, you'll see it here first, and every incident keeps its full update trail after resolution.</p>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var API = '/status/api';
  var REFRESH_MS = Math.max(15, (parseInt('<%= snap.monitor.interval_sec %>', 10) || 60)) * 1000;
  var timer = null;
  var auto = true;
  var busy = false;

  var LABELS = <%- JSON.stringify(labels) %>;
  var COMP_LABELS = <%- JSON.stringify(componentLabels) %>;
  var WINDOWS = ['24h', '7d', '30d', '90d'];

  function setText(id, val) {
    var el = document.getElementById(id);
    if (el) el.textContent = val;
  }
  function setStatus(id, status) {
    var el = document.getElementById(id);
    if (el) {
      var base = el.className;
      ['operational', 'degraded', 'partial_outage', 'major_outage'].forEach(function (s) {
        base = base.replace(new RegExp('(^|\\s)st-' + s + '(\\s|$)', 'g'), ' ');
      });
      el.className = (base.replace(/\s+/g, ' ').trim() + ' st-' + status).trim();
    }
  }

  function applySnapshot(snap) {
    if (!snap) return;
    var overall = snap.status || 'operational';
    setStatus('st-hero', 'st-' + overall);
    setText('st-hero-title', LABELS[overall] || overall);

    var sub = document.getElementById('st-hero-sub');
    if (sub) {
      var active = (snap.active_incidents || []).length;
      var html;
      if (active) {
        html = '<b>' + active + ' active incident' + (active === 1 ? '' : 's') + '</b> — we\'re on it.';
      } else if (overall === 'operational') {
        html = 'All monitored systems are up and responding normally.';
      } else {
        html = 'Some systems are experiencing issues. We\'re working to restore normal service.';
      }
      sub.innerHTML = html;
    }

    setText('st-last-checked', (snap.last_checked || snap.timestamp || '').slice(0, 16).replace('T', ' ') + ' UTC');

    var up = snap.uptime || {};
    WINDOWS.forEach(function (k) {
      var cell = document.querySelector('[data-uptime-cell="' + k + '"]');
      if (!cell) return;
      var num = cell.querySelector('.st-up-n');
      if (num) num.textContent = up[k] != null ? up[k] + '%' : '—';
    });

    (snap.components || []).forEach(function (c) {
      var row = document.querySelector('[data-comp="' + c.slug + '"]');
      if (!row) return;
      var dot = row.querySelector('[data-comp-dot]');
      if (dot) {
        dot.className = 'st-dot st-dot-' + c.status;
        dot.setAttribute('data-comp-dot', c.status);
      }
      var pill = row.querySelector('[data-comp-pill]');
      if (pill) {
        pill.className = 'st-pill st-pill-' + c.status;
        pill.setAttribute('data-comp-pill', c.status);
        pill.textContent = COMP_LABELS[c.status] || c.status_label || c.status;
      }
      var uptime = c.uptime || {};
      WINDOWS.forEach(function (k) {
        var upEl = row.querySelector('[data-uptime="' + k + '"]');
        if (!upEl) return;
        var bar = upEl.querySelector('.st-bar');
        var num = upEl.querySelector('.st-cmp-num');
        var v = uptime[k];
        var pct = (v == null || isNaN(Number(v))) ? null : Math.min(100, Math.round(Number(v)));
        if (bar) {
          if (pct == null) { bar.style.width = '0%'; bar.className = 'st-bar st-bar-warn'; }
          else {
            bar.style.width = pct + '%';
            bar.className = 'st-bar st-bar-' + (pct >= 99 ? 'ok' : 'warn');
          }
        }
        if (num) num.textContent = pct == null ? '—' : pct + '%';
      });
    });

    var refreshEl = document.getElementById('st-refresh-status');
    if (refreshEl) {
      var last = (snap.last_checked || snap.timestamp || '');
      refreshEl.textContent = 'Latest status as of ' + last.slice(0, 16).replace('T', ' ') + ' UTC.';
    }
    var toggle = document.getElementById('st-refresh-toggle');
    if (toggle) toggle.textContent = 'Auto-refresh: ' + (auto ? 'on' : 'off');
  }

  function refreshNow() {
    if (busy) return Promise.resolve();
    busy = true;
    return fetch(API, { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(applySnapshot)
      .catch(function () { /* server briefly unreachable — keep last good state */ })
      .finally(function () { busy = false; });
  }

  var nowBtn = document.getElementById('st-refresh-now');
  if (nowBtn) nowBtn.addEventListener('click', refreshNow);

  var toggleBtn = document.getElementById('st-refresh-toggle');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', function () {
      auto = !auto;
      setText('st-refresh-status', auto ? 'Auto-refresh is on — this page updates itself.' : 'Auto-refresh is paused. Click “Refresh now” to update.');
      if (auto) { refreshNow(); startTimer(); } else { stopTimer(); }
      toggleBtn.textContent = 'Auto-refresh: ' + (auto ? 'on' : 'off');
    });
  }

  function startTimer() {
    if (timer) clearInterval(timer);
    timer = setInterval(refreshNow, REFRESH_MS);
  }
  function stopTimer() {
    if (timer) { clearInterval(timer); timer = null; }
  }

  if (auto) { startTimer(); refreshNow(); }
})();
</script>
<%- include('../partials/bottom') %>
